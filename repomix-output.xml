1170: const FLEXIBLE_PROTOCOL_STORAGE_KEY = 'enology_flexible_protocol_params_v1';
1171: const FLEXIBLE_PROTOCOL_SYNC_EVENT = 'enology-flexible-protocol-sync';
1172: 
1173: function loadStoredFlexibleParams(): FlexibleProtocolParams {
1174:   if (typeof window === 'undefined') {
1175:     return IDEAL_DEFAULT_PROTOCOL_PARAMS;
1176:   }
1177:   try {
1178:     const raw = window.localStorage.getItem(FLEXIBLE_PROTOCOL_STORAGE_KEY);
1179:     if (raw) {
1180:       const parsed = JSON.parse(raw);
1181:       return {
1182:         ...IDEAL_DEFAULT_PROTOCOL_PARAMS,
1183:         ...parsed
1184:       };
1185:     }
1186:   } catch (err) {
1187:     console.warn('Error reading flexible protocol params from localStorage:', err);
1188:   }
1189:   return IDEAL_DEFAULT_PROTOCOL_PARAMS;
1190: }
1191: 
1192: export function getCurrentDynamicProtocolPlan(): DynamicProtocolPlan {
1193:   return computeDynamicProtocolPlan(loadStoredFlexibleParams());
1194: }
1195: 
1196: function sanitizeProtocolParamsSnapshot(
1197:   snapshot?: Record<string, number | string> | null
1198: ): Partial<FlexibleProtocolParams> | null {
1199:   if (!snapshot || typeof snapshot !== 'object') return null;
1200:   const sanitized: Record<string, number | string> = {};
1201:   for (const [k, val] of Object.entries(snapshot)) {
1202:     if (k === 'presetId') {
1203:       if (val === 'conservative_ideal' || val === 'classic_v32' || val === 'custom') {
1204:         sanitized[k] = val;
1205:       }
1206:     } else if (typeof val === 'number' && Number.isFinite(val)) {
1207:       sanitized[k] = val;
1208:     }
1209:   }
1210:   return Object.keys(sanitized).length > 0 ? (sanitized as Partial<FlexibleProtocolParams>) : null;
1211: }
1212: 
1213: export function getEffectiveProtocolPlanForBatch(
1214:   batch?: { protocolParamsSnapshot?: Record<string, number | string> } | null,
1215:   explicitPlan?: DynamicProtocolPlan,
1216:   preferExplicit: boolean = false
1217: ): DynamicProtocolPlan {
1218:   const sanitizedSnapshot = sanitizeProtocolParamsSnapshot(batch?.protocolParamsSnapshot);
1219:   if (!preferExplicit && sanitizedSnapshot) {
1220:     return computeDynamicProtocolPlan(sanitizedSnapshot);
1221:   }
1222:   if (explicitPlan) {
1223:     return explicitPlan;
1224:   }
1225:   if (sanitizedSnapshot) {
1226:     return computeDynamicProtocolPlan(sanitizedSnapshot);
1227:   }
1228:   return getCurrentDynamicProtocolPlan();
1229: }
