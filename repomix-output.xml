  31: /**
  32:  * Standard non-linear high-gravity enological equation for Alcohol By Volume (ABV % v/v)
  33:  * Accounts for density shifts and glycerol production in 12-15% ABV wine musts:
  34:  * ABV (% v/v) = ((76.08 * (OG - FG)) / (1.775 - OG)) * (FG / 0.794)
  35:  */
  36: export function calculateAlcoholByVolume(
  37:   initialSG: number,
  38:   currentSG: number
  39: ): number {
  40:   if (currentSG >= initialSG || initialSG >= 1.775 || currentSG <= 0) return 0;
  41:   const abv = ((76.08 * (initialSG - currentSG)) / (1.775 - initialSG)) * (currentSG / 0.794);
  42:   return Math.max(0, Math.round(abv * 10) / 10);
  43: }
