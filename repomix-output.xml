 57: const HYDROMETER_CALIBRATION_POINTS: ReadonlyArray<readonly [number, number]> = [
 58:   [10, -0.0016],
 59:   [12, -0.0013],
 60:   [14, -0.0010],
 61:   [16, -0.0007],
 62:   [18, -0.0004],
 63:   [20, 0.0000],
 64:   [22, 0.0004],
 65:   [24, 0.0009],
 66:   [26, 0.0014],
 67:   [28, 0.0020],
 68:   [30, 0.0026],
 69:   [32, 0.0032]
 70: ];
 71: 
 72: /**
 73:  * Normalizes Persian/Arabic digits, decimal separators, and shorthand integer SG readings (e.g., 1083 -> 1.083).
 74:  */
 75: export function normalizeEnologyNumericInput(
 76:   raw: string | number,
 77:   mode: 'sg' | 'general' = 'general'
 78: ): number | null {
 79:   let parsed: number;
 80:   if (typeof raw === 'number') {
 81:     if (!Number.isFinite(raw)) return null;
 82:     parsed = raw;
 83:   } else {
 84:     const persianDigits = '۰۱۲۳۴۵۶۷۸۹';
 85:     const arabicDigits = '٠١٢٣٤٥٦٧٨٩';
 86:     let cleaned = String(raw);
 87:     for (let i = 0; i < 10; i++) {
 88:       cleaned = cleaned
 89:         .replace(new RegExp(persianDigits[i], 'g'), String(i))
 90:         .replace(new RegExp(arabicDigits[i], 'g'), String(i));
 91:     }
 92:     cleaned = cleaned.replace(/\s+/g, '');
 93:     if (!cleaned || cleaned.includes('/') || !/^[+-]?\d+(?:[.,٫،]\d+)*$/.test(cleaned)) {
 94:       return null;
 95:     }
 96:     cleaned = cleaned.replace(/[٫،]/g, ',');
 97:     if (cleaned.includes(',') && cleaned.includes('.')) {
 98:       cleaned = cleaned.replace(/,/g, '');
 99:     } else if (cleaned.includes(',')) {
100:       const commaCount = (cleaned.match(/,/g) || []).length;
101:       if (
102:         commaCount > 1 ||
103:         (mode === 'general' && /^[+-]?\d{1,3}(,\d{3})+$/.test(cleaned))
104:       ) {
105:         cleaned = cleaned.replace(/,/g, '');
106:       } else {
107:         cleaned = cleaned.replace(/,/g, '.');
108:       }
109:     }
110:     if ((cleaned.match(/\./g) || []).length > 1) {
111:       return null;
112:     }
113:     parsed = Number.parseFloat(cleaned);
114:     if (Number.isNaN(parsed) || !Number.isFinite(parsed)) return null;
115:   }
116: 
117:   if (mode === 'sg' && Number.isInteger(parsed) && parsed >= 980 && parsed <= 1150) {
118:     return Math.round((parsed / 1000) * 10000) / 10000;
119:   }
120:   return parsed;
121: }
122: 
123: /**
124:  * Hydrometer temperature correction calibrated at 20°C or 15.5°C using piecewise linear interpolation.
125:  * Properly yields negative corrections for all temperatures below calibration point (e.g., 19°C -> -0.0002 at 20°C).
126:  */
127: export function correctHydrometer(
128:   measuredSG: number,
129:   tempC: number,
130:   calibrationTempC: 20 | 15.5 = 20
131: ): { trueSG: number; delta: number; isAbove32CWarning?: boolean; warningFa?: string } {
132:   let delta = 0;
133: 
134:   if (tempC <= HYDROMETER_CALIBRATION_POINTS[0][0]) {
135:     delta = HYDROMETER_CALIBRATION_POINTS[0][1];
136:   } else if (tempC > 32) {
137:     delta = 0.0032 + (tempC - 32) * 0.0003;
138:   } else if (tempC >= HYDROMETER_CALIBRATION_POINTS[HYDROMETER_CALIBRATION_POINTS.length - 1][0]) {
139:     delta = HYDROMETER_CALIBRATION_POINTS[HYDROMETER_CALIBRATION_POINTS.length - 1][1];
140:   } else {
141:     for (let i = 0; i < HYDROMETER_CALIBRATION_POINTS.length - 1; i++) {
142:       const [t0, d0] = HYDROMETER_CALIBRATION_POINTS[i];
143:       const [t1, d1] = HYDROMETER_CALIBRATION_POINTS[i + 1];
144:       if (tempC >= t0 && tempC <= t1) {
145:         const fraction = (tempC - t0) / (t1 - t0);
146:         delta = d0 + fraction * (d1 - d0);
147:         break;
148:       }
149:     }
150:   }
151: 
152:   if (calibrationTempC === 15.5) {
153:     // Note: +0.0008 is a linear approximation calibrated for the 18–24 °C sample range
154:     delta += 0.0008;
155:   }
156: 
157:   const roundedDelta = Math.round(delta * 10000) / 10000;
158:   const trueSG = Math.round((measuredSG + roundedDelta) * 10000) / 10000;
159: 
160:   if (tempC > 32) {
161:     return {
162:       trueSG,
163:       delta: roundedDelta,
164:       isAbove32CWarning: true,
165:       warningFa: 'نمونه را خنک کنید؛ فرمول فقط تا ۳۲ °C دقیق است'
166:     };
167:   }
168: 
169:   return { trueSG, delta: roundedDelta };
170: }
171: 
172: /**
173:  * Scales winery mass & volume based on grape weight (baseline: 400kg)
174:  */
175: export function calculateScaleVolumes(grapeKg: number) {
176:   if (grapeKg <= 0) {
177:     return {
178:       mashVolume: 0,
179:       liquidVolume: 0,
180:       saigneeVolume: 0,
181:       roseFinalVolume: 0,
182:       redFinalVolume: 0,
183:     };
184:   }
185:   const factor = grapeKg / MASTER_PROTOCOL_CONFIG.metadata.grapeWeightKg;
186:   return {
187:     mashVolume: Math.round(MASTER_PROTOCOL_CONFIG.volumes.totalCrushedMashL * factor),
188:     liquidVolume: Math.round(MASTER_PROTOCOL_CONFIG.volumes.initialLiquidL * factor),
189:     saigneeVolume: Math.round(MASTER_PROTOCOL_CONFIG.volumes.saigneeRoseRawL * factor),
190:     roseFinalVolume: Math.round(MASTER_PROTOCOL_CONFIG.volumes.roseFinalBottlingL * factor),
191:     redFinalVolume: Math.round(
192:       MASTER_PROTOCOL_CONFIG.volumes.postPressFreeRunConservativePerTankL * 2 * factor
193:     ),
194:   };
195: }
196: 
197: /**
198:  * Titratable Acidity (TA) test by NaOH titration
199:  * Formula: TA (g/L as Tartaric Acid) = (V_NaOH (mL) * N_NaOH * 75) / V_sample (mL)
200:  * (75 is the milliequivalent weight of tartaric acid * 1000 / 2 = 150 / 2 = 75)
201:  */
202: export function calculateTitratableAcidity(
203:   vNaOH_mL: number,
204:   nNaOH: number = 0.1,
205:   vSample_mL: number = 5
206: ): number {
207:   if (vSample_mL <= 0 || vNaOH_mL <= 0) return 0;
208:   const ta = (vNaOH_mL * nNaOH * 75) / vSample_mL;
209:   return Math.round(ta * 100) / 100;
210: }
211: 
212: /**
213:  * Calculates Tartaric Acid addition to reach target TA
214:  * Formula: Tartaric Acid (g) = (Target TA - Current TA) * Effective Liquid Volume (L)
215:  */
216: export function calculateTartaricAddition(
217:   currentTA: number,
218:   targetTA: number,
219:   volumeL: number,
220:   isUnpressedRedMust: boolean | VolumeBasis = false,
221:   mashYieldFactor: number = 0.84
222: ): number {
223:   if (volumeL <= 0) return 0;
224:   const effectiveVol = getEffectiveLiquidVolume(volumeL, isUnpressedRedMust, mashYieldFactor);
225:   const diff = Math.max(0, targetTA - currentTA);
226:   return Math.round(diff * effectiveVol * 10) / 10;
227: }
228: 
229: /**
230:  * Empirical pH-shift bench-trial range estimator decoupled from TA stoichiometry.
231:  * Wine/must buffering capacity (β) varies between 30 and 55 mEq/(L·pH) (average ~42 mEq/(L·pH)),
232:  * so pH shift alone CANNOT determine an exact stoichiometric dose without bench trials or ΔTA.
233:  */
234: export function estimateAcidOrBaseFromPHShift(
235:   currentPH: number,
236:   targetPH: number,
237:   effectiveVolumeL: number
238: ): {
239:   mode: 'acidification' | 'deacidification' | 'none';
240:   reagentFa: string;
241:   lowBufferGrams: number;
242:   typicalBufferGrams: number;
243:   highBufferGrams: number;
244:   isEmpiricalEstimateOnly: true;
245:   warningFa: string;
246: } {
247:   const vol = Math.max(0, effectiveVolumeL);
248:   if (currentPH > targetPH && vol > 0) {
249:     const steps = (currentPH - targetPH) / 0.1;
250:     return {
251:       mode: 'acidification',
252:       reagentFa: 'اسید تارتاریک L(+)',
253:       lowBufferGrams: Math.round(steps * 0.75 * vol * 10) / 10,
254:       typicalBufferGrams: Math.round(steps * 1.00 * vol * 10) / 10,
255:       highBufferGrams: Math.round(steps * 1.35 * vol * 10) / 10,
256:       isEmpiricalEstimateOnly: true,
257:       warningFa:
258:         'تخمین تجربی بر پایه ظرفیت بافری میانگین (صرفاً برای شروع تست ۳ لیوانی — غیرقابل تزریق مستقیم بدون سنجش TA!)'
259:     };
260:   }
261:   if (currentPH < targetPH && vol > 0) {
262:     const steps = (targetPH - currentPH) / 0.1;
263:     return {
264:       mode: 'deacidification',
265:       reagentFa: 'بیکربنات پتاسیم (KHCO3)',
266:       lowBufferGrams: Math.round(steps * 0.90 * vol * 10) / 10,
267:       typicalBufferGrams: Math.round(steps * 1.20 * vol * 10) / 10,
268:       highBufferGrams: Math.round(steps * 1.50 * vol * 10) / 10,
269:       isEmpiricalEstimateOnly: true,
270:       warningFa:
271:         'تخمین تجربی بر پایه ظرفیت بافری میانگین (صرفاً برای شروع تست ۳ لیوانی — استوکیومتری دقیق نیازمند ΔTA است!)'
272:     };
273:   }
274:   return {
275:     mode: 'none',
276:     reagentFa: 'بدون نیاز به اصلاح',
277:     lowBufferGrams: 0,
278:     typicalBufferGrams: 0,
279:     highBufferGrams: 0,
280:     isEmpiricalEstimateOnly: true,
281:     warningFa: ''
282:   };
283: }
284: 
285: /**
286:  * Returns all 3 stoichiometric deacidification options for a given TA reduction (g/L) and effective liquid volume (L):
287:  * - Pure stoichiometric KHCO3: 1.33 g/L per 1.0 g/L Tartaric Acid (2 * 100.115 / 150.09 = 1.334)
288:  * - KHCO3 with Cold Stabilization KHT precipitation: 1.00 g/L per 1.0 g/L TA
289:  * - Calcium Carbonate (CaCO3): 0.67 g/L per 1.0 g/L TA (100.09 / 150.09 = 0.667)
290:  */
291: export function calculateDeacidificationOptions(
292:   deltaTA_gL: number,
293:   effectiveVolumeL: number
294: ): {
295:   khco3StoichiometricGrams: number;
296:   khco3WithColdStabGrams: number;
297:   caco3Grams: number;
298: } {
299:   if (deltaTA_gL <= 0 || effectiveVolumeL <= 0) {
300:     return {
301:       khco3StoichiometricGrams: 0,
302:       khco3WithColdStabGrams: 0,
303:       caco3Grams: 0
304:     };
305:   }
306:   const {
307:     khco3GramsPerGL_TA,
308:     khco3WithColdStabGramsPerGL_TA,
309:     caco3GramsPerGL_TA
310:   } = MASTER_PROTOCOL_CONFIG.stoichiometry;
311: 
312:   return {
313:     khco3StoichiometricGrams: Math.round(deltaTA_gL * khco3GramsPerGL_TA * effectiveVolumeL * 10) / 10,
314:     khco3WithColdStabGrams: Math.round(deltaTA_gL * khco3WithColdStabGramsPerGL_TA * effectiveVolumeL * 10) / 10,
315:     caco3Grams: Math.round(deltaTA_gL * caco3GramsPerGL_TA * effectiveVolumeL * 10) / 10
316:   };
317: }
318: 
319: /**
320:  * Calculates Potassium Bicarbonate (KHCO3) deacidification dosage in grams.
321:  * Note: True stoichiometry (1.33 g/L KHCO3 per 1.0 g/L TA reduction) requires `deltaTA_gL`.
322:  * When `deltaTA_gL` is not provided, returns an empirical starting estimate for a 3-glass bench trial.
323:  */
324: export function calculateKHCO3Deacidification(
325:   currentPH: number,
326:   targetMinPH: number,
327:   volumeL: number,
328:   isUnpressedRedMust: boolean | VolumeBasis = false,
329:   deltaTA_gL?: number,
330:   mashYieldFactor: number = 0.84
331: ): number {
332:   if (volumeL <= 0) return 0;
333:   const effectiveVol = getEffectiveLiquidVolume(volumeL, isUnpressedRedMust, mashYieldFactor);
334:   const khco3Rate = MASTER_PROTOCOL_CONFIG.stoichiometry.khco3GramsPerGL_TA; // 1.33 g/L
335: 
336:   if (deltaTA_gL !== undefined && deltaTA_gL > 0) {
337:     return Math.round(deltaTA_gL * khco3Rate * effectiveVol * 10) / 10;
338:   }
339: 
340:   if (currentPH >= targetMinPH) return 0;
341:   return estimateAcidOrBaseFromPHShift(currentPH, targetMinPH, effectiveVol).typicalBufferGrams;
342: }
