 101: /**
 102:  * Chronological comparator for FermentationLogEntry items, handling multiple same-day logs safely
 103:  */
 104: export function sortFermentationLogs(logs: FermentationLogEntry[]): FermentationLogEntry[] {
 105:   return [...logs].sort((a, b) => {
 106:     if (a.dayNumber !== b.dayNumber) return a.dayNumber - b.dayNumber;
 107:     if (a.timestampMs !== undefined && b.timestampMs !== undefined && a.timestampMs !== b.timestampMs) {
 108:       return a.timestampMs - b.timestampMs;
 109:     }
 110:     const hourA = parseTimeHourFromDateTime(a.dateTime);
 111:     const hourB = parseTimeHourFromDateTime(b.dateTime);
 112:     if (hourA !== null && hourB !== null && hourA !== hourB) {
 113:       return hourA - hourB;
 114:     }
 115:     if (a.sg !== b.sg) return b.sg - a.sg; // Higher SG is earlier in fermentation on the same day
 116:     return a.id.localeCompare(b.id);
 117:   });
 118: }
