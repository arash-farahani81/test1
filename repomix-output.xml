  1: /**
  2:  * Pure calculation helpers for enological testing, laboratory SOPs, and winery calculations
  3:  */
  4: import { MASTER_PROTOCOL_CONFIG } from '../data/masterProtocolConfig.ts';
  5: 
  6: /**
  7:  * Checks whether a given volume is already the pure liquid-phase volume from the Master Protocol
  8:  * (e.g., 132 L per tank after Saignée, 264 L total, 150 L initial liquid per tank, 300 L total, 32 L Rosé).
  9:  * Helps prevent operators from accidentally applying the mash-to-liquid yield discount twice on 132 L.
 10:  */
 11: export function isAlreadyLiquidVolume(volumeL: number): boolean {
 12:   const rounded = Math.round(volumeL);
 13:   return (
 14:     rounded === MASTER_PROTOCOL_CONFIG.volumes.redLiquidFermentPerTankL || // 132 L
 15:     rounded === MASTER_PROTOCOL_CONFIG.volumes.redLiquidFermentTotalL || // 264 L
 16:     rounded === MASTER_PROTOCOL_CONFIG.volumes.initialLiquidPerTankL || // 150 L
 17:     rounded === MASTER_PROTOCOL_CONFIG.volumes.initialLiquidL || // 300 L
 18:     rounded === MASTER_PROTOCOL_CONFIG.volumes.roseClarifiedFermentL // 32 L
 19:   );
 20: }
 21: 
 22: /**
 23:  * Returns the effective liquid-phase volume in liters.
 24:  * During red wine maceration (unpressed mash with skins/cap: 157 L total mash = 132 L liquid + 25 L cap),
 25:  * the true liquid-to-mash ratio is 132 / 157 = 0.8408 (~0.84 yield factor vs. 1.0 for pressed wine or Rosé).
 26:  */
 27: export type VolumeBasis = 'liquid_phase' | 'gross_mash';
 28: 
 29: export function getEffectiveLiquidVolume(
 30:   volumeL: number,
 31:   isUnpressedRedMustOrBasis: boolean | VolumeBasis = false,
 32:   mashYieldFactor: number = 0.84
 33: ): number {
 34:   if (volumeL <= 0) return 0;
 35:   const isGrossMash = isUnpressedRedMustOrBasis === true || isUnpressedRedMustOrBasis === 'gross_mash';
 36:   const factor = isGrossMash ? (mashYieldFactor > 0 && mashYieldFactor <= 1 ? mashYieldFactor : 0.84) : 1.0;
 37:   return Math.round(volumeL * factor * 100) / 100;
 38: }
 39: 
 40: /**
 41:  * Calculates pure Potassium Metabisulfite (KMS) required in grams
 42:  * Formula: KMS (g) = ((Target Free SO2 - Current Free SO2) * Effective Liquid Volume in Liters) / 576
 43:  */
 44: export function calculateKMS(
 45:   volumeL: number,
 46:   currentSO2: number,
 47:   targetSO2: number,
 48:   isUnpressedRedMust: boolean | VolumeBasis = false,
 49:   mashYieldFactor: number = 0.84
 50: ): number {
 51:   if (volumeL <= 0) return 0;
 52:   const effectiveVol = getEffectiveLiquidVolume(volumeL, isUnpressedRedMust, mashYieldFactor);
 53:   const diff = Math.max(0, targetSO2 - currentSO2);
 54:   return Math.round(((diff * effectiveVol) / 576) * 100) / 100;
 55: }
