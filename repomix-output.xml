 172: function formatSecondsMMSS(totalSeconds: number): string {
 173:   const s = Math.max(0, Math.floor(totalSeconds));
 174:   const hrs = Math.floor(s / 3600);
 175:   const mins = Math.floor((s % 3600) / 60);
 176:   const secs = s % 60;
 177:   if (hrs > 0) {
 178:     return `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
 179:   }
 180:   return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
 181: }
 182: 
 183: function parseTimeToMinutes(timeStr: string): number {
 184:   if (!timeStr || !timeStr.includes(':')) return 14 * 60 + 30;
 185:   const [h, m] = timeStr.split(':').map(Number);
 186:   if (isNaN(h) || isNaN(m)) return 14 * 60 + 30;
 187:   return h * 60 + m;
 188: }
 189: 
 190: function formatMinutesToTime(totalMins: number): string {
 191:   const normalizedMins = ((Math.round(totalMins) % 1440) + 1440) % 1440;
 192:   const h = Math.floor(normalizedMins / 60);
 193:   const m = normalizedMins % 60;
 194:   return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
 195: }
