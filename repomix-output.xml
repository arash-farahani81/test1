590: /**
591:  * Continuous Henderson-Hasselbalch Free SO2 target (pKa1 = 1.81) eliminating step-table jumps:
592:  * Free SO2 = Molecular SO2 * (1 + 10^(pH - 1.81))
593:  */
594: export function getContinuousTargetFreeSO2ByPH(
595:   ph: number,
596:   isRose: boolean = false,
597:   targetMolecularMgL?: number
598: ): {
599:   min: number;
600:   max: number;
601:   target: number;
602:   targetMolecularMgL: number;
603:   formulaText: string;
604: } {
605:   const clampedPH = Math.max(2.8, Math.min(4.2, Number.isFinite(ph) ? ph : 3.5));
606:   const factor = 1 + Math.pow(10, clampedPH - 1.81);
607:   const effectiveTargetMolecular =
608:     targetMolecularMgL !== undefined && targetMolecularMgL > 0
609:       ? targetMolecularMgL
610:       : isRose
611:       ? 0.75
612:       : 0.65;
613:   const minMolecular = isRose ? 0.60 : 0.55;
614:   const maxMolecular = isRose ? 0.85 : 0.80;
615: 
616:   const min = Math.round(Math.max(18, minMolecular * factor) * 10) / 10;
617:   const target = Math.round(Math.max(22, effectiveTargetMolecular * factor) * 10) / 10;
618:   const max = Math.round(Math.max(target, maxMolecular * factor) * 10) / 10;
619: 
620:   return {
621:     min,
622:     max,
623:     target,
624:     targetMolecularMgL: effectiveTargetMolecular,
625:     formulaText: `Free SO2 = ${effectiveTargetMolecular} × (1 + 10^(pH - 1.81))`
626:   };
627: }
