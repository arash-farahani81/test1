 153:   tankAdditions: ChemicalAddition[],
 154:   completedRoadmapStepIds: number[],
 155:   roadmapStepIds: number[]
 156: ): boolean {
 157:   if (
 158:     completedRoadmapStepIds.length > 0 &&
 159:     roadmapStepIds.length > 0 &&
 160:     roadmapStepIds.every((id) => completedRoadmapStepIds.includes(id))
 161:   ) {
 162:     return true;
 163:   }
 164: 
 165:   for (const add of tankAdditions) {
 166:     if (add.isDeleted) continue;
 167:     if (add.milestoneId !== undefined) {
 168:       if (add.milestoneId === milestoneId) return true;
 169:       continue;
 170:     }
 171:     const text = `${add.stageTitle} ${add.purpose} ${add.compoundName}`;
 172:     switch (milestoneId) {
 173:       case 'crush-kms':
 174:         if (
 175:           (add.compoundType === 'kms' ||
 176:             add.pubchemCid === 24446 ||
 177:             /kms|متابیسولفیت|متابی‌سولفیت/i.test(text)) &&
 178:           (add.referenceVolumeL === 150 || text.includes('کراش') || text.includes('اولیه'))
 179:         ) {
 180:           return true;
 181:         }
 182:         break;
 183:       case 'saignee-rose':
 184:         if (
 185:           (add.compoundType === 'kms' || add.pubchemCid === 24446 || text.includes('KMS')) &&
 186:           (text.includes('سانیه') || text.includes('خون‌گیری') || text.includes('+15'))
 187:         ) {
 188:           return true;
 189:         }
 190:         break;
 191:       case 'pectic-enzyme':
 192:         if (add.compoundType === 'enzyme' || text.includes('پکتین') || text.includes('آنزیم')) {
 193:           return true;
 194:         }
 195:         break;
 196:       case 'yeast-inoculation':
 197:         if (
 198:           add.compoundType === 'yeast' ||
 199:           add.compoundType === 'go_ferm' ||
 200:           text.includes('مخمر') ||
 201:           text.includes('RC-212')
 202:         ) {
 203:           return true;
 204:         }
 205:         break;
 206:       case 'sna-1':
 207:         if (
 208:           (add.compoundType === 'fermaid_o' || /fermaid\s*o/i.test(text)) &&
 209:           (text.includes('SNA-1') ||
 210:             text.includes('نوبت اول') ||
 211:             text.includes('روز ۲') ||
 212:             (add.sgAtAddition !== undefined && add.sgAtAddition >= 1.072))
 213:         ) {
 214:           return true;
 215:         }
 216:         break;
 217:       case 'sna-2-dap':
 218:         if (text.includes('SNA-2') || text.includes('نوبت دوم')) {
 219:           return true;
 220:         }
 221:         if (
 222:           tankAdditions.some((a) => !a.isDeleted && a.compoundType === 'fermaid_k') &&
 223:           tankAdditions.some((a) => !a.isDeleted && a.compoundType === 'dap')
 224:         ) {
 225:           return true;
 226:         }
 227:         break;
 228:       case 'phase2-tannin':
 229:         if (
 230:           text.includes('فاز ۲') ||
 231:           text.includes('فاز 2') ||
 232:           text.includes('1.060') ||
 233:           (add.compoundType === 'tannin_red' &&
 234:             !text.includes('فاز ۱') &&
 235:             !text.includes('فاز 1') &&
 236:             !text.includes('روز ۰') &&
 237:             !text.includes('ساعت ۱۱') &&
 238:             add.sgAtAddition !== undefined &&
 239:             add.sgAtAddition <= 1.065 &&
 240:             add.sgAtAddition >= 1.052)
 241:         ) {
 242:           return true;
 243:         }
 244:         break;
 245:       case 'sna-3-organic':
 246:         if (
 247:           (add.compoundType === 'fermaid_o' || /fermaid\s*o/i.test(text)) &&
 248:           (text.includes('SNA-3') ||
 249:             text.includes('نوبت سوم') ||
 250:             text.includes('نهایی') ||
 251:             (add.sgAtAddition !== undefined && add.sgAtAddition < 1.068))
 252:         ) {
 253:           return true;
 254:         }
 255:         break;
 256:       case 'pressing':
 257:         if (text.includes('پرسینگ') || text.includes('جداسازی پوست')) {
 258:           return true;
 259:         }
 260:         break;
 261:       case 'racking-1-gross-lees':
 262:         if (text.includes('سیفون اول') || text.includes('دُرد درشت')) {
 263:           return true;
 264:         }
 265:         break;
 266:       case 'day11-bactiless-kms-lock':
 267:         if (
 268:           add.compoundType === 'bactiless' ||
 269:           /bactiless|ب[ا]?کتی[‌]?لس/i.test(text) ||
 270:           text.includes('روز ۱۱')
 271:         ) {
 272:           return true;
 273:         }
 274:         break;
 275:       case 'day21-bactiless-racking':
 276:         if (text.includes('روز ۲۱') || text.includes('سیفون باکتی')) {
 277:           return true;
 278:         }
 279:         break;
 280:       case 'day65-cold-stab':
 281:         if (
 282:           add.compoundType === 'kht' ||
 283:           text.includes('کرم تارتار') ||
 284:           text.includes('پایدارسازی سرد')
 285:         ) {
 286:           return true;
 287:         }
 288:         break;
 289:       case 'day100-bottling':
 290:         if (
 291:           add.compoundType === 'ascorbic' ||
 292:           text.includes('بطری‌گذاری') ||
 293:           text.includes('اسکوربیک')
 294:         ) {
 295:           return true;
 296:         }
 297:         break;
 298:     }
 299:   }
 300: 
 301:   return false;
 302: }
