431: /**
432:  * Staggered Nutrient Addition (SNA) calculations based on batch volume, must Brix, and Specific Gravity (SG).
433:  * - Sugar (g/L) = Brix * 10 * SG (converts % w/w Brix to % w/v g/L using SG).
434:  * - Uses Rasha Master Protocol Station 3 strain multipliers: low = 0.75, medium = 0.90 (216 mg N/L at 22 Brix), high = 1.10.
435:  * - Closed-form nitrogen mass balance: at 116 mg N/L deficit, DAP (0.15 g/L = 31.8 mg N/L) + Fermaid K (0.25 g/L = 25.0 mg N/L)
436:  *   + Fermaid O (0.50 g/L total = 20.0 mg N/L chemical or 60.0 mg N/L Lallemand 3x bio-equivalent) = 116.8 mg N eq/L.
437:  */
438: export function calculateSNAAmounts(
439:   volumeL: number,
440:   brix: number = 22,
441:   sgOrStrain: number | 'low' | 'medium' | 'high' = 'medium',
442:   naturalYAN: number = 100,
443:   sgOptional?: number,
444:   isUnpressedRedMust: boolean | VolumeBasis = false,
445:   mashYieldFactor: number = 0.84,
446:   customRates?: {
447:     fermaidO1RateGL?: number;
448:     fermaidK2RateGL?: number;
449:     dap2RateGL?: number;
450:     fermaidO3RateGL?: number;
451:     zincRateGL?: number;
452:   }
453: ) {
454:   const effectiveVolumeL = getEffectiveLiquidVolume(Math.max(0, volumeL), isUnpressedRedMust, mashYieldFactor);
455:   const explicitSG = typeof sgOrStrain === 'number' ? sgOrStrain : sgOptional;
456:   const effectiveBrix =
457:     explicitSG && explicitSG > 0 && brix === 22 && Math.abs(explicitSG - 1.092) >= 0.004
458:       ? Math.max(0, Math.round(261.3 * (1 - 1 / explicitSG) * 10) / 10)
459:       : Math.max(0, brix);
460: 
461:   const strainMultiplier =
462:     sgOrStrain === 'low' ? 0.75 : sgOrStrain === 'high' ? 1.10 : 1.05;
463: 
464:   const initialSG =
465:     explicitSG && explicitSG > 0
466:       ? explicitSG
467:       : effectiveBrix > 0
468:       ? Math.round((1 + effectiveBrix / (258.6 - effectiveBrix * 0.88)) * 1000) / 1000
469:       : 1.0;
470: 
471:   // Sugar (g/L) = Brix * 10 * SG
472:   const sugarGPerL = Math.round(effectiveBrix * 10 * initialSG * 10) / 10;
473:   const sugarGL = Math.round(sugarGPerL);
474:   const targetYAN = Math.round(sugarGL * strainMultiplier);
475:   const neededYAN = Math.max(0, targetYAN - naturalYAN);
476: 
477:   // Baseline Needed YAN at 22 Brix (SG 1.092 -> Sugar 240 g/L -> Target 252 -> Needed 152 mg N/L)
478:   const baselineNeededYAN = 152;
479:   const yanScale = neededYAN > 0 ? neededYAN / baselineNeededYAN : 0;
480: 
481:   const fermaidO1Rate = customRates?.fermaidO1RateGL ?? 0.25;
482:   const fermaidK2Rate = customRates?.fermaidK2RateGL ?? 0.25;
483:   const dap2Rate = customRates?.dap2RateGL ?? 0.15;
484:   const fermaidO3Rate = customRates?.fermaidO3RateGL ?? 0.30;
485:   const zincRate =
486:     customRates?.zincRateGL ??
487:     MASTER_PROTOCOL_CONFIG.stoichiometry.zincSulfateHeptahydrateSafeRateGPerL;
488: 
489:   // Step 1: 24h post-inoculation / 10% sugar break (SG ~ 1.083) - 100% Organic Fermaid O
490:   const fermaidO_1 = Math.round(fermaidO1Rate * yanScale * effectiveVolumeL * 100) / 100;
491:   // Step 2: 24-25% sugar drop (SG ~ 1.070, before 1/3 sugar ceiling 1.062) - All Fermaid K & DAP + safe micro-Zinc
492:   const fermaidK_2 = Math.round(fermaidK2Rate * yanScale * effectiveVolumeL * 100) / 100;
493:   const dap_2 = Math.round(Math.min(0.30, dap2Rate * yanScale) * effectiveVolumeL * 100) / 100;
494:   const zinc_2 = Math.round(zincRate * effectiveVolumeL * 100) / 100;
495:   // Step 3: ~38% sugar drop (SG ~ 1.057) - Strictly 100% Organic Nitrogen (Fermaid O), 0g Fermaid K / DAP
496:   const fermaidO_3 = Math.round(fermaidO3Rate * yanScale * effectiveVolumeL * 100) / 100;
497: 
498:   const fermaidOGPerL = effectiveVolumeL > 0 ? (fermaidO_1 + fermaidO_3) / effectiveVolumeL : 0;
499:   const fermaidKGPerL = effectiveVolumeL > 0 ? fermaidK_2 / effectiveVolumeL : 0;
500:   const dapGPerL = effectiveVolumeL > 0 ? dap_2 / effectiveVolumeL : 0;
501: 
502:   const suppliedChemicalYAN_mgL =
503:     effectiveVolumeL > 0
504:       ? Math.round((fermaidOGPerL * 40 + fermaidKGPerL * 100 + dapGPerL * 212) * 10) / 10
505:       : 0;
506: 
507:   const suppliedBioEquivalentYAN_mgL =
508:     effectiveVolumeL > 0
509:       ? Math.round((fermaidOGPerL * 120 + fermaidKGPerL * 100 + dapGPerL * 212) * 10) / 10
510:       : 0;
511: 
512:   const additionalFermaidOForPureChemicalParityG = Math.max(
513:     0,
514:     Math.round(((neededYAN - suppliedChemicalYAN_mgL) / 40) * effectiveVolumeL * 100) / 100
515:   );
516: 
517:   return {
518:     initialSG,
519:     effectiveVolumeL,
520:     sugarGL,
521:     sugarGPerL,
522:     targetYAN,
523:     neededYAN,
524:     fermaidO_1,
525:     fermaidK_2,
526:     dap_2,
527:     zinc_2,
528:     fermaidO_3,
529:     fermaidK_3: 0,
530:     suppliedChemicalYAN_mgL,
531:     suppliedBioEquivalentYAN_mgL,
532:     additionalFermaidOForPureChemicalParityG,
533:     zincNoteFa:
534:       'با توجه به حضور ریزمغذی روی در Go-Ferm و Fermaid K، دوز سولفات روی خالص (ZnSO4·7H2O) روی سقف ایمن ۲ mg/L (معادل ۰.۴۵ mg/L یون روی عنصری) قفل شده است.'
535:   };
536: }
