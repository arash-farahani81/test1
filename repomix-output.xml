1265: /**
1266:  * React hook for reading and customizing the Flexible Parameterized Enology Protocol
1267:  * with Ideal Recommended Defaults, Classic v3.2 preset support, and 1-click reset.
1268:  */
1269: export function useFlexibleProtocol() {
1270:   const [params, setParamsState] = useState<FlexibleProtocolParams>(loadStoredFlexibleParams);
1271: 
1272:   const persistAndBroadcast = useCallback(
1273:     (
1274:       nextOrUpdater:
1275:         | FlexibleProtocolParams
1276:         | ((prev: FlexibleProtocolParams) => FlexibleProtocolParams)
1277:     ) => {
1278:       setParamsState((prev) => {
1279:         const next =
1280:           typeof nextOrUpdater === 'function' ? nextOrUpdater(prev) : nextOrUpdater;
1281:         notifyFlexibleProtocolSync(next);
1282:         return next;
1283:       });
1284:     },
1285:     []
1286:   );
1287: 
1288:   useEffect(() => {
1289:     if (typeof window === 'undefined') return;
1290:     const handleSync = (e: Event) => {
1291:       const customEvent = e as CustomEvent<FlexibleProtocolParams>;
1292:       if (customEvent.detail) {
1293:         setParamsState(customEvent.detail);
1294:       }
1295:     };
1296:     window.addEventListener(FLEXIBLE_PROTOCOL_SYNC_EVENT, handleSync);
1297:     return () => window.removeEventListener(FLEXIBLE_PROTOCOL_SYNC_EVENT, handleSync);
1298:   }, []);
1299: 
1300:   const updateParam = useCallback(
1301:     <K extends Exclude<keyof FlexibleProtocolParams, 'presetId'>>(
1302:       key: K,
1303:       value: FlexibleProtocolParams[K]
1304:     ) => {
1305:       persistAndBroadcast((prev) => ({
1306:         ...prev,
1307:         [key]: value,
1308:         presetId: 'custom'
1309:       }));
1310:     },
1311:     [persistAndBroadcast]
1312:   );
1313: 
1314:   const updateParams = useCallback(
1315:     (partial: Partial<Omit<FlexibleProtocolParams, 'presetId'>>) => {
1316:       persistAndBroadcast((prev) => ({
1317:         ...prev,
1318:         ...partial,
1319:         presetId: 'custom'
1320:       }));
1321:     },
1322:     [persistAndBroadcast]
1323:   );
1324: 
1325:   const applyPreset = useCallback(
1326:     (presetId: 'conservative_ideal' | 'classic_v32') => {
1327:       const target =
1328:         presetId === 'classic_v32' ? CLASSIC_V32_PROTOCOL_PARAMS : IDEAL_DEFAULT_PROTOCOL_PARAMS;
1329:       persistAndBroadcast({ ...target });
1330:     },
1331:     [persistAndBroadcast]
1332:   );
1333: 
1334:   const resetParamToIdeal = useCallback(
1335:     <K extends Exclude<keyof FlexibleProtocolParams, 'presetId'>>(key: K) => {
1336:       persistAndBroadcast((prev) => {
1337:         const next: FlexibleProtocolParams = {
1338:           ...prev,
1339:           [key]: IDEAL_DEFAULT_PROTOCOL_PARAMS[key]
1340:         };
1341:         const allMatchIdeal = FLEXIBLE_PARAM_METADATA.every(
1342:           (m) => next[m.key] === IDEAL_DEFAULT_PROTOCOL_PARAMS[m.key]
1343:         );
1344:         next.presetId = allMatchIdeal ? 'conservative_ideal' : 'custom';
1345:         return next;
1346:       });
1347:     },
1348:     [persistAndBroadcast]
1349:   );
1350: 
1351:   const resetAllToIdeal = useCallback(() => {
1352:     persistAndBroadcast({ ...IDEAL_DEFAULT_PROTOCOL_PARAMS });
1353:   }, [persistAndBroadcast]);
1354: 
1355:   const isModifiedFromIdeal = useMemo(
1356:     () =>
1357:       FLEXIBLE_PARAM_METADATA.some(
1358:         (m) => params[m.key] !== IDEAL_DEFAULT_PROTOCOL_PARAMS[m.key]
1359:       ),
1360:     [params]
1361:   );
1362: 
1363:   const plan = useMemo(() => computeDynamicProtocolPlan(params), [params]);
1364: 
1365:   return {
1366:     params,
1367:     plan,
1368:     updateParam,
1369:     updateParams,
1370:     applyPreset,
1371:     resetParamToIdeal,
1372:     resetAllToIdeal,
1373:     isModifiedFromIdeal
1374:   };
1375: }
