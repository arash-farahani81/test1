 833: /**
 834:  * Convenience helper to compute recent SG drop velocity (SG/day) from unsorted or sorted logs
 835:  */
 836: export function calculateVelocity(logs: FermentationLogEntry[], tankId?: TankId): number {
 837:   const scoped = tankId ? logs.filter((l) => l.tankId === tankId) : logs;
 838:   const sorted = sortFermentationLogs(scoped);
 839:   const { recentVelocityPerDay } = calculateRecentLogVelocity(sorted);
 840:   return Math.round(recentVelocityPerDay * 10000) / 10000;
 841: }
