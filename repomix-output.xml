1805: export function evaluateBottlingReadinessGate(options: {
1806:   logs: FermentationLogEntry[];
1807:   additions: ChemicalAddition[];
1808:   labAnalyses: LabAnalysisRecord[];
1809:   batch?: WineBatch;
1810:   batchId?: string;
1811:   excludeDemo?: boolean;
1812:   tankId?: TankId;
1813:   requireRsLabConfirmation?: boolean;
1814:   manualConfirmations?: {
1815:     clarityConfirmed?: boolean;
1816:     coldStabConfirmedOrSkipped?: boolean;
1817:     warmTestPassed?: boolean;
1818:     sanitationConfirmed?: boolean;
1819:     malicRiskAccepted?: boolean;
1820:     clinitestPassed?: boolean;
1821:     rsConfirmed?: boolean;
1822:   };
1823:   riskOverrideReason?: string;
1824:   nowMs?: number;
1825: }): BottlingReadinessResult {
1826:   const tankId: TankId = options.tankId ?? 'tank-a';
1827:   const isRose = tankId === 'tank-rose';
1828:   const nowMs = options.nowMs ?? Date.now();
1829:   const confirmations = options.manualConfirmations ?? {};
1830:   const activeBatchId = options.batchId ?? options.batch?.id;
1831:   const hasExplicitBatchFilter = Boolean(activeBatchId);
1832:   const rejectOrphanRecords = Boolean(
1833:     hasExplicitBatchFilter && options.excludeDemo === true
1834:   );
1835: 
1836:   const matchesBatch = (recordBatchId?: string): boolean => {
1837:     if (!hasExplicitBatchFilter) return true;
1838:     if (!recordBatchId) return !rejectOrphanRecords;
1839:     return recordBatchId === activeBatchId;
1840:   };
1841: 
1842:   const tankLogsAll = options.logs.filter((l) => !l.isDeleted && l.tankId === tankId);
1843:   const realLogs = tankLogsAll.filter(
1844:     (l) => !l.isBenchmark && !l.isDemo && matchesBatch(l.batchId)
