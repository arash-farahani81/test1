 766:         changed = true;
 767:         return { ...a, batchId: targetBatchId, updatedAtMs: now };
 768:       }
 769:       return a;
 770:     });
 771: 
 772:     if (changed) {
 773:       this.hasLocalMutations = true;
 774:       this.persistLogs();
 775:       this.persistAdditions();
 776:       this.persistAnalyses();
 777:       this.incrementChangesSinceBackup();
