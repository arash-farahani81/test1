 594:   const inferStructuredCompoundType = (name: string, cid?: number): StructuredCompoundType => {
 595:     const lower = name.toLowerCase();
 596:     if (cid === 24446 || lower.includes('kms') || lower.includes('متابی') || lower.includes('سولفیت')) return 'kms';
 597:     if (lower.includes('bactiless') || lower.includes('بکتی')) return 'bactiless';
 598:     if (lower.includes('fermaid o')) return 'fermaid_o';
 599:     if (lower.includes('fermaid k')) return 'fermaid_k';
 600:     if (lower.includes('dap') || lower.includes('آمونیاک')) return 'dap';
 601:     if (lower.includes('zinc') || lower.includes('روی')) return 'zinc';
 602:     if (lower.includes('تانن سفید')) return 'tannin_white';
 603:     if (lower.includes('تانن')) return 'tannin_red';
 604:     if (lower.includes('آنزیم') || lower.includes('پکتین')) return 'enzyme';
 605:     if (lower.includes('تارتاریک')) return 'tartaric';
 606:     if (lower.includes('بی‌کربنات') || lower.includes('khco3')) return 'khco3';
 607:     if (lower.includes('کربنات کلسیم') || lower.includes('caco3')) return 'caco3';
 608:     if (lower.includes('مس') || lower.includes('copper')) return 'copper';
 609:     if (lower.includes('کرم تارتار') || lower.includes('kht')) return 'kht';
 610:     if (lower.includes('گلیسیرین')) return 'glycerin';
 611:     if (lower.includes('اسکوربیک') || lower.includes('ویتامین c')) return 'ascorbic';
 612:     if (lower.includes('پراکسید') || lower.includes('h2o2')) return 'h2o2';
 613:     if (lower.includes('go-ferm')) return 'go_ferm';
 614:     if (lower.includes('مخمر') || lower.includes('rc-212')) return 'yeast';
 615:     if (lower.includes('بنتونیت')) return 'bentonite';
 616:     return 'other';
 617:   };
