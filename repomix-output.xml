 252: function formatIcsDateTimeLocal(baseDate: Date, addDays: number, hour: number): string {
 253:   const d = new Date(baseDate.getTime());
 254:   d.setDate(d.getDate() + addDays);
 255:   d.setHours(hour, 0, 0, 0);
 256:   const pad = (n: number) => String(n).padStart(2, '0');
 257:   return `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}T${pad(
 258:     d.getHours()
 259:   )}0000`;
 260: }
