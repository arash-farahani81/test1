 121: async function getAllPhotosFromIdb(): Promise<PhotoDiaryEntry[]> {
 122:   const db = await openPhotoIdb();
 123:   if (!db) {
 124:     if (typeof localStorage === 'undefined') return [];
 125:     try {
 126:       const raw = localStorage.getItem(IDB_FALLBACK_LS_KEY);
 127:       return raw ? (JSON.parse(raw) as PhotoDiaryEntry[]) : [];
 128:     } catch {
 129:       return [];
 130:     }
 131:   }
 132:   return new Promise((resolve) => {
 133:     try {
 134:       const tx = db.transaction(IDB_STORE_NAME, 'readonly');
 135:       const store = tx.objectStore(IDB_STORE_NAME);
 136:       const req = store.getAll();
 137:       req.onsuccess = () => resolve((req.result as PhotoDiaryEntry[]) ?? []);
 138:       req.onerror = () => resolve([]);
 139:     } catch {
 140:       resolve([]);
 141:     }
 142:   });
 143: }
