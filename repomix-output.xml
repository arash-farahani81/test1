 258: /**
 259:  * Robust Client Database Engine with in-memory sync, LocalStorage, and IndexedDB backup
 260:  */
 261: class EnologyDatabaseService {
 262:   private batches: WineBatch[] = [];
 263:   private logs: FermentationLogEntry[] = [];
 264:   private additions: ChemicalAddition[] = [];
 265:   private analyses: LabAnalysisRecord[] = [];
 266:   private calculations: SavedCalculation[] = [];
 267:   private isInitialized = false;
 268:   private hasLocalMutations = false;
 269:   private storageErrorsByKey: Record<string, string> = {};
 270:   private lastStorageError: string | null = null;
 271:   private corruptedKeysRecovered: string[] = [];
 272:   private lastBackupMs: number | null = null;
 273:   private changesSinceBackup = 0;
 274: 
 275:   constructor() {
 276:     this.init();
 277:     onFlexibleProtocolSync((params) => {
 278:       this.syncActiveBatchProtocolSnapshot(params);
 279:     });
 280:     if (typeof window !== 'undefined' && typeof window.addEventListener === 'function') {
 281:       window.addEventListener('enology-flexible-protocol-sync', (e: Event) => {
 282:         const customEvent = e as CustomEvent<FlexibleProtocolParams>;
 283:         if (customEvent.detail) {
 284:           this.syncActiveBatchProtocolSnapshot(customEvent.detail);
 285:         }
 286:       });
 287:     }
 288:   }
 289: 
 290:   private preserveCorruptRawValue(key: string, rawValue: string) {
 291:     this.corruptedKeysRecovered.push(key);
 292:     if (typeof localStorage === 'undefined') return;
 293:     try {
 294:       const dateSuffix = new Date().toISOString().slice(0, 10);
 295:       localStorage.setItem(`corrupt_${key}_${dateSuffix}`, rawValue);
 296:     } catch {
 297:       // Ignore storage failure when preserving corrupt payload
 298:     }
 299:   }
 300: 
 301:   private handleStorageSetItem(key: string, serialized: string) {
 302:     if (typeof localStorage === 'undefined') return;
 303:     try {
 304:       localStorage.setItem(key, serialized);
 305:       delete this.storageErrorsByKey[key];
 306:       this.lastStorageError = Object.values(this.storageErrorsByKey)[0] ?? null;
 307:     } catch (e) {
 308:       const errMsg =
 309:         'ذخیره نشد؛ حافظهٔ مرورگر پر است یا مسدود شده است. همین الان فایل پشتیبان بگیرید.';
 310:       this.storageErrorsByKey[key] = errMsg;
 311:       this.lastStorageError = Object.values(this.storageErrorsByKey)[0] ?? errMsg;
 312:       if (typeof window !== 'undefined' && typeof window.dispatchEvent === 'function') {
 313:         window.dispatchEvent(
 314:           new CustomEvent('enology-storage-error', { detail: this.lastStorageError })
 315:         );
 316:       }
 317:       console.error(`Error persisting ${key}`, e);
 318:     }
 319:   }
 320: 
 321:   private loadBackupMeta() {
 322:     if (typeof localStorage === 'undefined') return;
 323:     try {
 324:       const raw = localStorage.getItem(DB_STORAGE_KEY_BACKUP_META);
 325:       if (raw) {
 326:         const parsed = JSON.parse(raw) as { lastBackupMs?: unknown; changesSinceBackup?: unknown };
 327:         this.lastBackupMs = typeof parsed.lastBackupMs === 'number' ? parsed.lastBackupMs : null;
 328:         this.changesSinceBackup =
 329:           typeof parsed.changesSinceBackup === 'number' ? parsed.changesSinceBackup : 0;
 330:       }
 331:     } catch {
 332:       this.lastBackupMs = null;
 333:       this.changesSinceBackup = 0;
 334:     }
 335:   }
 336: 
 337:   private persistBackupMeta() {
 338:     if (typeof localStorage === 'undefined') return;
 339:     try {
 340:       localStorage.setItem(
 341:         DB_STORAGE_KEY_BACKUP_META,
 342:         JSON.stringify({
 343:           lastBackupMs: this.lastBackupMs,
 344:           changesSinceBackup: this.changesSinceBackup
 345:         })
 346:       );
 347:     } catch {
 348:       // Ignore backup meta persistence failure
 349:     }
 350:   }
 351: 
 352:   private incrementChangesSinceBackup() {
 353:     this.changesSinceBackup += 1;
 354:     this.persistBackupMeta();
 355:   }
 356: 
 357:   private parseArrayWithSalvage<T>(
 358:     key: string,
 359:     rawJson: string,
 360:     itemSchema: z.ZodType<T>,
 361:     fallback: T[]
 362:   ): T[] {
 363:     try {
 364:       const parsed: unknown = JSON.parse(rawJson);
 365:       const full = z.array(itemSchema).safeParse(parsed);
 366:       if (full.success) {
 367:         return full.data;
 368:       }
 369:       this.preserveCorruptRawValue(key, rawJson);
 370:       if (Array.isArray(parsed)) {
 371:         const salvaged: T[] = [];
 372:         for (const item of parsed) {
 373:           const r = itemSchema.safeParse(item);
 374:           if (r.success) {
 375:             salvaged.push(r.data);
 376:           }
 377:         }
 378:         if (salvaged.length > 0) {
 379:           return salvaged;
 380:         }
 381:       }
 382:       return [...fallback];
 383:     } catch {
 384:       this.preserveCorruptRawValue(key, rawJson);
 385:       return [...fallback];
 386:     }
 387:   }
