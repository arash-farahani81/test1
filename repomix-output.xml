 732: /**
 733:  * Helper to get absolute substrate depletion factor for a given SG
 734:  */
 735: function getSubstrateDepletionFactor(sg: number): number {
 736:   if (sg <= 1.005) return 0.65;
 737:   if (sg <= 1.030) return 0.85;
 738:   return 1.0;
 739: }
 740: 
 741: /**
 742:  * Computes recent SG drop velocity (SG units per day) from sorted logs while preventing
 743:  * division-by-zero on multiple same-day logs via timestampMs, parsed hours, or previous-day lookback.
 744:  */
 745: export function calculateRecentLogVelocity(
 746:   sortedLogs: FermentationLogEntry[],
 747:   initialSGOverride?: number
 748: ): { recentVelocityPerDay: number; hasObservedVelocity: boolean; referenceSG: number } {
 749:   const baselineVel = 0.0125;
 750:   const fallbackInitialSG = initialSGOverride ?? getCurrentDynamicProtocolPlan().triggers.initialSG;
 751:   if (sortedLogs.length === 0) {
 752:     return { recentVelocityPerDay: baselineVel, hasObservedVelocity: false, referenceSG: fallbackInitialSG };
 753:   }
 754: 
 755:   const latestLog = sortedLogs[sortedLogs.length - 1];
 756: 
 757:   if (sortedLogs.length >= 2) {
 758:     const prevLog = sortedLogs[sortedLogs.length - 2];
 759: 
 760:     // Priority 1: Both logs have timestampMs
 761:     if (
 762:       latestLog.timestampMs !== undefined &&
 763:       prevLog.timestampMs !== undefined &&
 764:       latestLog.timestampMs !== prevLog.timestampMs
 765:     ) {
 766:       const diffDays = Math.abs(latestLog.timestampMs - prevLog.timestampMs) / (1000 * 60 * 60 * 24);
 767:       const daySpan = Math.max(0.02, diffDays);
 768:       const sgDrop = Math.max(0, prevLog.sg - latestLog.sg);
 769:       return {
 770:         recentVelocityPerDay: sgDrop / daySpan,
 771:         hasObservedVelocity: true,
 772:         referenceSG: prevLog.sg
 773:       };
 774:     }
 775: 
 776:     // Priority 2: Both logs have valid parsed hours in dateTime
 777:     const hourPrev = parseTimeHourFromDateTime(prevLog.dateTime);
 778:     const hourLatest = parseTimeHourFromDateTime(latestLog.dateTime);
 779:     if (hourPrev !== null && hourLatest !== null && latestLog.dayNumber >= prevLog.dayNumber) {
 780:       const elapsedHours = (latestLog.dayNumber - prevLog.dayNumber) * 24 + (hourLatest - hourPrev);
 781:       if (elapsedHours > 0) {
 782:         const daySpan = Math.max(0.02, elapsedHours / 24);
 783:         const sgDrop = Math.max(0, prevLog.sg - latestLog.sg);
 784:         return {
 785:           recentVelocityPerDay: sgDrop / daySpan,
 786:           hasObservedVelocity: true,
 787:           referenceSG: prevLog.sg
 788:         };
 789:       }
 790:     }
 791: 
 792:     // Priority 3: If same dayNumber without elapsed hours, look back to previous day
 793:     if (latestLog.dayNumber === prevLog.dayNumber) {
 794:       for (let i = sortedLogs.length - 2; i >= 0; i--) {
 795:         if (sortedLogs[i].dayNumber < latestLog.dayNumber) {
 796:           const prevDayLog = sortedLogs[i];
 797:           const daySpan = Math.max(0.2, latestLog.dayNumber - prevDayLog.dayNumber);
 798:           const sgDrop = Math.max(0, prevDayLog.sg - latestLog.sg);
 799:           return {
 800:             recentVelocityPerDay: sgDrop / daySpan,
 801:             hasObservedVelocity: true,
 802:             referenceSG: prevDayLog.sg
 803:           };
 804:         }
 805:       }
 806:     }
 807: 
 808:     // Priority 4: Fallback to dayNumber difference
 809:     const daySpan = Math.max(0.2, latestLog.dayNumber - prevLog.dayNumber);
 810:     const sgDrop = Math.max(0, prevLog.sg - latestLog.sg);
 811:     return {
 812:       recentVelocityPerDay: sgDrop / daySpan,
 813:       hasObservedVelocity: true,
 814:       referenceSG: prevLog.sg
 815:     };
 816:   }
 817: 
 818:   // Single log on Day > 0
 819:   if (latestLog.dayNumber > 0) {
 820:     const initialSG = fallbackInitialSG;
 821:     const sgDrop = Math.max(0, initialSG - latestLog.sg);
 822:     const daySpan = Math.max(0.2, latestLog.dayNumber);
 823:     return {
 824:       recentVelocityPerDay: sgDrop / daySpan,
 825:       hasObservedVelocity: sgDrop > 0,
 826:       referenceSG: initialSG
 827:     };
 828:   }
 829: 
 830:   return { recentVelocityPerDay: baselineVel, hasObservedVelocity: false, referenceSG: latestLog.sg };
 831: }
