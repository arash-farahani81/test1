 719:   // --- Orphan Records Inspection & Reassignment ---
 720:   public getOrphanRecordsSummary(): {
 721:     orphanLogsCount: number;
 722:     orphanAdditionsCount: number;
 723:     orphanAnalysesCount: number;
 724:   } {
 725:     const validBatchIds = new Set(this.batches.map((b) => b.id));
 726:     const orphanLogsCount = this.logs.filter(
 727:       (l) => !l.isDeleted && !l.isBenchmark && (!l.batchId || !validBatchIds.has(l.batchId))
 728:     ).length;
 729:     const orphanAdditionsCount = this.additions.filter(
 730:       (a) => !a.isDeleted && (!a.batchId || !validBatchIds.has(a.batchId))
 731:     ).length;
 732:     const orphanAnalysesCount = this.analyses.filter(
 733:       (a) => !a.isDeleted && (!a.batchId || !validBatchIds.has(a.batchId))
 734:     ).length;
 735: 
 736:     return {
 737:       orphanLogsCount,
 738:       orphanAdditionsCount,
 739:       orphanAnalysesCount
 740:     };
 741:   }
