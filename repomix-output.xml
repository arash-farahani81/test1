 1: import fs from 'node:fs';
 2: import path from 'node:path';
 3: 
 4: const ROOT_DIR = process.cwd();
 5: const TARGET_FILES: string[] = [
 6:   path.join(ROOT_DIR, 'src', 'App.tsx'),
 7:   ...fs
 8:     .readdirSync(path.join(ROOT_DIR, 'src', 'components'))
 9:     .filter((f) => f.endsWith('.tsx'))
10:     .map((f) => path.join(ROOT_DIR, 'src', 'components', f))
11: ];
12: 
13: const RULES: Array<{ name: string; regex: RegExp }> = [
14:   {
15:     name: 'Arbitrary pixel font sizes (text-[Npx])',
16:     regex: /\btext-\[\d+px\]/
17:   },
18:   {
19:     name: 'Over-heavy font weights (font-black / font-extrabold)',
20:     regex: /\bfont-(?:black|extrabold)\b/
21:   },
22:   {
23:     name: 'Decorative emoji characters in TSX',
24:     regex: /[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]/u
25:   },
26:   {
27:     name: 'Banned meta-architecture strings',
28:     regex: /(?:معماری ۵ تبی|سازماندهی ۳ گروهی|سازمان‌دهی ۳ گروهی|دسترسی سریع کارگاهی)/
29:   }
30: ];
31: 
32: let violationCount = 0;
33: 
34: for (const filePath of TARGET_FILES) {
35:   if (!fs.existsSync(filePath)) continue;
36:   const relPath = path.relative(ROOT_DIR, filePath);
37:   const content = fs.readFileSync(filePath, 'utf-8');
38:   const lines = content.split(/\r?\n/);
39: 
40:   lines.forEach((line, idx) => {
41:     for (const rule of RULES) {
42:       if (rule.regex.test(line)) {
43:         console.error(
44:           `[UI LINT ERROR] ${relPath}:${idx + 1} — ${rule.name}\n  > ${line.trim()}`
45:         );
46:         violationCount++;
47:       }
48:     }
49:   });
50: }
51: 
52: if (violationCount > 0) {
53:   console.error(`\nUI Lint Check failed with ${violationCount} violation(s).`);
54:   process.exit(1);
55: } else {
56:   console.log('UI Lint Check passed (0 violations).');
57: }
</file>

