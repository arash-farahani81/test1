538: /**
539:  * Bench fining scaling from test trial rate (g/L) to full cellar tank
540:  */
541: export function calculateBenchFiningGrams(doseG_per_L: number, tankVolume_L: number): number {
542:   if (doseG_per_L <= 0 || tankVolume_L <= 0) return 0;
543:   return Math.round(doseG_per_L * tankVolume_L * 100) / 100;
