1579: export function evaluateDeadlineCountdowns(options: {
1580:   logs: FermentationLogEntry[];
1581:   additions: ChemicalAddition[];
1582:   labAnalyses?: LabAnalysisRecord[];
1583:   tankId?: TankId;
1584:   plan?: DynamicProtocolPlan;
1585:   batch?: WineBatch;
1586:   batchId?: string;
1587:   excludeDemo?: boolean;
1588: }): DeadlineCountdownItem[] {
1589:   const tankId: TankId = options.tankId ?? 'tank-a';
1590:   const isRose = tankId === 'tank-rose';
1591:   const plan = getEffectiveProtocolPlanForBatch(options.batch, options.plan);
1592:   const dynTriggers = calculateDynamicSGTriggers(plan.triggers.initialSG, {
1593:     pressingPoint: plan.triggers.pressingSG,
1594:     drynessPoint: isRose ? 0.991 : plan.triggers.drynessSG
1595:   });
1596: 
1597:   const activeBatchId = options.batchId ?? options.batch?.id ?? 'batch-rasha-1403';
1598:   const hasExplicitBatchFilter = Boolean(options.batchId || options.batch?.id);
1599:   const rejectOrphanRecords = Boolean(
1600:     hasExplicitBatchFilter && options.excludeDemo === true
1601:   );
1602:   const hasRealUserData = Boolean(
1603:     options.excludeDemo ||
1604:       options.batch?.isDemo === false ||
1605:       options.logs.some(
1606:         (l) =>
1607:           !l.isDeleted &&
1608:           !l.isBenchmark &&
1609:           !l.isDemo &&
1610:           (!l.batchId ? !rejectOrphanRecords : l.batchId === activeBatchId)
1611:       ) ||
1612:       options.additions.some(
1613:         (a) =>
1614:           !a.isDeleted &&
1615:           !a.isDemo &&
1616:           (!a.batchId ? !rejectOrphanRecords : a.batchId === activeBatchId)
1617:       )
1618:   );
1619: 
1620:   const isRecordMatchingActiveBatch = (recordBatchId?: string, recordTankId?: TankId): boolean => {
1621:     if (!hasExplicitBatchFilter) return true;
1622:     if (!recordBatchId) {
1623:       return !rejectOrphanRecords;
1624:     }
1625:     if (recordBatchId === activeBatchId) return true;
1626:     if (
1627:       !hasRealUserData &&
1628:       activeBatchId === 'batch-rasha-1403' &&
1629:       recordTankId === 'tank-rose' &&
1630:       recordBatchId === 'batch-rose-1403'
1631:     ) {
1632:       return true;
1633:     }
1634:     return false;
1635:   };
1636: 
1637:   const tankLogsAll = options.logs.filter((l) => {
1638:     if (l.isDeleted || l.tankId !== tankId) return false;
1639:     if (!isRecordMatchingActiveBatch(l.batchId, l.tankId)) {
1640:       return false;
1641:     }
1642:     if (hasRealUserData && (l.isDemo === true || l.isBenchmark === true)) {
1643:       return false;
1644:     }
1645:     return true;
1646:   });
1647:   const realTankLogs = tankLogsAll.filter((l) => !l.isBenchmark);
1648:   const sortedLogs = sortFermentationLogs(
1649:     realTankLogs.length > 0 ? realTankLogs : tankLogsAll
1650:   );
1651:   const latestLog = sortedLogs[sortedLogs.length - 1];
1652:   const currentSG = latestLog ? latestLog.sg : dynTriggers.initialSG;
1653:   const currentDay = latestLog ? latestLog.dayNumber : 0;
1654:   const currentPH = latestLog ? latestLog.ph : 3.52;
1655: 
1656:   const tankAdditions = options.additions.filter((a) => {
1657:     if (a.isDeleted || a.tankId !== tankId) return false;
1658:     if (!isRecordMatchingActiveBatch(a.batchId, a.tankId)) {
1659:       return false;
1660:     }
1661:     if (hasRealUserData && a.isDemo === true) {
1662:       return false;
1663:     }
1664:     return true;
1665:   });
1666: 
1667:   const items: DeadlineCountdownItem[] = [];
1668: 
1669:   // 1. DAP 1/3 Sugar Break Window (SG 1.062)
1670:   const sna2Done = isMilestoneCompletedByAdditions(
1671:     'sna-2-dap',
1672:     tankAdditions,
1673:     [],
1674:     [17]
1675:   );
1676:   if (!sna2Done && currentSG > 1.010) {
1677:     const oneThirdCeiling = dynTriggers.oneThirdCeiling;
1678:     if (currentSG < oneThirdCeiling) {
1679:       items.push({
1680:         id: 'dap_window',
1681:         titleFa: 'پنجرهٔ قانونی تغذیه DAP (سقف ۱/۳ مصرف قند)',
1682:         rangeTextFa: 'پنجره بسته شد',
1683:         color: 'gray',
1684:         urgencyLevel: 'closed',
1685:         explanationFa: `چگالی به ${currentSG.toFixed(3)} رسیده و از مرز ${oneThirdCeiling.toFixed(3)} عبور کرده است؛ افزودن DAP یا Fermaid K در الکل بالای ۶٪ ممنوع است (صرفاً Fermaid O مجاز است).`
1686:       });
1687:     } else {
1688:       const velInfo = calculateRecentLogVelocity(
1689:         sortedLogs,
1690:         dynTriggers.initialSG
1691:       );
1692:       const vel =
1693:         velInfo.hasObservedVelocity && velInfo.recentVelocityPerDay > 0.001
1694:           ? velInfo.recentVelocityPerDay
1695:           : 0.015;
1696:       const lagBufferHours =
1697:         currentDay <= 1 && !velInfo.hasObservedVelocity ? 24 : 0;
1698:       const baseHours = ((currentSG - oneThirdCeiling) / vel) * 24 + lagBufferHours;
1699:       const minH = Math.max(1, Math.round(baseHours * 0.8));
1700:       const maxH = Math.max(minH + 1, Math.round(baseHours * 1.25));
1701: 
1702:       const color: DeadlineCountdownItem['color'] =
1703:         baseHours > 24 ? 'emerald' : baseHours >= 6 ? 'amber' : 'rose';
1704:       const urgencyLevel: DeadlineCountdownItem['urgencyLevel'] =
1705:         baseHours > 24 ? 'safe' : baseHours >= 6 ? 'warning' : 'critical';
1706: 
1707:       items.push({
1708:         id: 'dap_window',
1709:         titleFa: 'مهلت باقی‌مانده تا بسته شدن پنجرهٔ DAP (SG 1.062)',
1710:         rangeTextFa: `حدود ${minH} تا ${maxH} ساعت تا بسته شدن پنجرهٔ DAP`,
1711:         color,
1712:         urgencyLevel,
1713:         explanationFa: `بر اساس سرعت افت چگالی فعلی (${vel.toFixed(3)} SG/day)، پنجرهٔ مجاز نیتروژن معدنی در SG = ${oneThirdCeiling.toFixed(3)} بسته می‌شود.`
1714:       });
1715:     }
1716:   }
1717: 
1718:   // 2. Bactiless 5-10 Day Contact Window
1719:   const bactilessAdd = tankAdditions.find(
1720:     (a) =>
1721:       a.compoundType === 'bactiless' ||
1722:       /bactiless|ب[ا]?کتی[‌]?لس/i.test(`${a.stageTitle} ${a.purpose} ${a.compoundName}`)
1723:   );
1724:   const racking21Done = isMilestoneCompletedByAdditions(
1725:     'day21-bactiless-racking',
1726:     tankAdditions,
1727:     [],
1728:     [28]
1729:   );
1730:   if (bactilessAdd && !racking21Done) {
1731:     let elapsedDays = 0;
1732:     if (bactilessAdd.dayNumber !== undefined) {
1733:       elapsedDays = Math.max(0, currentDay - bactilessAdd.dayNumber);
1734:     } else if (
1735:       bactilessAdd.timestampMs !== undefined &&
1736:       latestLog?.timestampMs !== undefined &&
1737:       latestLog.timestampMs >= bactilessAdd.timestampMs
1738:     ) {
1739:       elapsedDays = Math.max(
1740:         0,
1741:         Math.round((latestLog.timestampMs - bactilessAdd.timestampMs) / (1000 * 60 * 60 * 24))
1742:       );
1743:     } else {
1744:       const addDayMatch = bactilessAdd.stageTitle.match(/روز\s*([۰-۹0-9]+)/);
1745:       let addDay = 11;
1746:       if (addDayMatch) {
1747:         const persianDigits = '۰۱۲۳۴۵۶۷۸۹';
1748:         const ascii = addDayMatch[1].replace(/[۰-۹]/g, (d) => String(persianDigits.indexOf(d)));
1749:         const parsed = Number.parseInt(ascii, 10);
1750:         if (!Number.isNaN(parsed)) addDay = parsed;
1751:       } else if (/یازدهم/.test(bactilessAdd.stageTitle)) {
1752:         addDay = 11;
1753:       } else if (/دوازدهم/.test(bactilessAdd.stageTitle)) {
1754:         addDay = 12;
1755:       } else if (/دهم/.test(bactilessAdd.stageTitle)) {
1756:         addDay = 10;
1757:       }
1758:       elapsedDays = Math.max(0, currentDay - addDay);
1759:     }
1760:     const color: DeadlineCountdownItem['color'] =
1761:       elapsedDays > 10 ? 'rose' : elapsedDays >= 5 ? 'amber' : 'emerald';
1762:     const urgencyLevel: DeadlineCountdownItem['urgencyLevel'] =
1763:       elapsedDays > 10 ? 'critical' : elapsedDays >= 5 ? 'warning' : 'safe';
1764: 
1765:     items.push({
1766:       id: 'bactiless_contact',
1767:       titleFa: 'پنجرهٔ تماس کیتوزان (Bactiless) تا سیفون',
1768:       rangeTextFa: `روز ${elapsedDays} از ۱۰ تماس؛ سیفون از ۵ تا ۱۰ روز پس از افزودن`,
1769:       color,
1770:       urgencyLevel,
1771:       explanationFa:
1772:         'کیتوزان قارچی پس از ۵ تا ۱۰ روز دیواره سلولی باکتری‌ها را کامل لیز کرده و باید پیش از ایجاد طعم گس از شراب سیفون شود.'
1773:     });
1774:   }
1775: 
1776:   // 3. Post-Dryness Unprotected Wine Alert (SG <= 0.995)
1777:   if (latestLog && latestLog.sg <= 0.995) {
1778:     const targetSO2 = getContinuousTargetFreeSO2ByPH(currentPH, isRose);
1779:     const hasPostFermKms = tankAdditions.some(
1780:       (a) =>
1781:         (a.compoundType === 'kms' || a.pubchemCid === 24446 || a.compoundName.includes('KMS')) &&
1782:         ((a.sgAtAddition !== undefined && a.sgAtAddition <= 1.000) ||
1783:           a.stageTitle.includes('روز ۱۱') ||
1784:           a.stageTitle.includes('پس از تخمیر') ||
1785:           a.stageTitle.includes('بطری'))
1786:     );
1787:     const hasAdequateFreeSO2 =
1788:       latestLog.freeSO2 !== undefined && latestLog.freeSO2 >= targetSO2.min;
1789: 
1790:     if (!hasPostFermKms && !hasAdequateFreeSO2) {
1791:       items.push({
1792:         id: 'post_dryness_so2',
1793:         titleFa: 'هشدار فوری: شراب خشک بدون سپر محافظ سولفیت (Free SO₂)',
