1039:   const computeEffectiveDays = (entries: FermentationLogEntry[]): number[] => {
1040:     const countsByDay = new Map<number, number>();
1041:     entries.forEach((e) => {
1042:       countsByDay.set(e.dayNumber, (countsByDay.get(e.dayNumber) || 0) + 1);
1043:     });
1044:     const seenByDay = new Map<number, number>();
1045:     return entries.map((e) => {
1046:       const totalOnDay = countsByDay.get(e.dayNumber) || 1;
1047:       const idxOnDay = seenByDay.get(e.dayNumber) || 0;
1048:       seenByDay.set(e.dayNumber, idxOnDay + 1);
1049:       if (totalOnDay <= 1) return e.dayNumber;
1050:       return e.dayNumber + (idxOnDay / totalOnDay) * 0.65;
1051:     });
1052:   };
