1795:         color: 'rose',
1796:         urgencyLevel: 'critical',
1797:         explanationFa: `تخمیر به خشکی رسیده است (SG = ${latestLog.sg.toFixed(3)}) و دیگر لایه محافظ گاز CO2 تولید نمی‌شود. برای pH = ${currentPH.toFixed(2)} حداقل ${targetSO2.min} mg/L سولفیت آزاد (هدف: ${targetSO2.target} mg/L) الزامی است.`
1798:       });
1799:     }
1800:   }
1801: 
1802:   return items;
1803: }
