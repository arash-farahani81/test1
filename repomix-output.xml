177: export function getGlossaryItem(key: string): EnologyGlossaryItem | undefined {
178:   const normalized = key.trim().toLowerCase().replace(/[\s-]+/g, '_');
179:   return ENOLOGY_GLOSSARY_DICTIONARY[normalized] ?? ENOLOGY_GLOSSARY_DICTIONARY[key];
180: }
