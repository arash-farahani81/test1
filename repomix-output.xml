<file path="src/utils/persianDate.ts">
 1: /**
 2:  * Shared Persian Date/Time Formatter (BUG-106)
 3:  * Formats epoch milliseconds into a consistent Solar Hijri (fa-IR-u-ca-persian) date and 24-hour time string.
 4:  */
 5: export function getCurrentPersianDateTimeStr(nowMs: number = Date.now()): string {
 6:   const d = new Date(Number.isFinite(nowMs) ? nowMs : Date.now());
 7:   try {
 8:     const datePart = d.toLocaleDateString('fa-IR-u-ca-persian', {
 9:       year: 'numeric',
10:       month: '2-digit',
11:       day: '2-digit'
12:     });
13:     const timePart = d.toLocaleTimeString('fa-IR', {
14:       hour: '2-digit',
15:       minute: '2-digit',
16:       hour12: false
17:     });
18:     return `${datePart} - ${timePart}`;
19:   } catch {
20:     return d.toLocaleDateString('fa-IR');
21:   }
22: }
