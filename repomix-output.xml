  20: export function calculateFermentationProgress(
  21:   sg: number,
  22:   initialSG: number = MASTER_PROTOCOL_CONFIG.metadata.targetInitialSG,
  23:   finalSG: number = MASTER_PROTOCOL_CONFIG.metadata.redFinalSG
  24: ): number {
  25:   const totalSpan = initialSG - finalSG;
  26:   if (totalSpan <= 0) return 0;
  27:   const consumed = initialSG - sg;
  28:   return Math.min(100, Math.max(0, Math.round((consumed / totalSpan) * 100)));
  29: }
