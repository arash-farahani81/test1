371: /**
372:  * Refractometer alcohol correction during fermentation (Sean Terrill Cubic Equation).
373:  * In Sean Terrill's polynomial, all Original Brix (ob) terms are negative and all Current Brix (cb) terms are positive:
374:  * SG = 1.001843 - 0.002318474*OB - 0.000007775*OB^2 - 0.000000034*OB^3
375:  *               + 0.00574*CB + 0.00003344*CB^2 + 0.000000086*CB^3
376:  */
377: export function calculateRefractometerCorrection(
378:   origBrix: number,
379:   currentRefractometerBrix: number
380: ): {
381:   trueBrix: number;
382:   trueSG: number;
383:   abv: number;
384:   isWortEmpiricalApproximation: true;
385:   disclaimerFa: string;
386: } {
387:   const disclaimerFa =
388:     'تخمین تجربی اپتیکی (کالیبرهشده با چگالی اولیه؛ برای تصمیمگیریهای حساس SNA و پرسینگ صرفاً به هیدرومتر استناد شود)';
389:   if (origBrix <= 0) {
390:     return { trueBrix: 0, trueSG: 1.0, abv: 0, isWortEmpiricalApproximation: true, disclaimerFa };
391:   }
392:   const ob = origBrix;
393:   const cb = currentRefractometerBrix;
394: 
395:   const origSG = Math.round((1 + ob / (258.6 - ob * 0.88)) * 10000) / 10000;
396: 
397:   const terrillAt = (o: number, c: number) =>
398:     1.001843 -
399:     0.002318474 * o -
400:     0.000007775 * Math.pow(o, 2) -
401:     0.000000034 * Math.pow(o, 3) +
402:     0.00574 * c +
403:     0.00003344 * Math.pow(c, 2) +
404:     0.000000086 * Math.pow(c, 3);
405: 
406:   const calibratedSG = cb >= ob ? origSG : terrillAt(ob, cb) + (origSG - terrillAt(ob, ob));
407:   const roundedSG = Math.max(0.985, Math.round(calibratedSG * 10000) / 10000);
408: 
409:   if (cb >= ob) {
410:     return {
411:       trueBrix: Math.round(ob * 10) / 10,
412:       trueSG: roundedSG,
413:       abv: 0,
414:       isWortEmpiricalApproximation: true,
415:       disclaimerFa
416:     };
417:   }
418: 
419:   // True brix approximate from SG
420:   const trueBrix = Math.max(0, Math.round(((roundedSG - 1.0) / 0.004) * 10) / 10);
421: 
422:   const rawAbv =
423:     roundedSG >= origSG || origSG >= 1.775
424:       ? 0
425:       : ((76.08 * (origSG - roundedSG)) / (1.775 - origSG)) * (roundedSG / 0.794);
426:   const abv = Math.max(0, Math.round(rawAbv * 10) / 10);
427: 
428:   return { trueBrix, trueSG: roundedSG, abv, isWortEmpiricalApproximation: true, disclaimerFa };
429: }
