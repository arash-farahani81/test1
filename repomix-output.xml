 389:   public async hydrateFromIndexedDBIfNeeded(): Promise<boolean> {
 390:     if (typeof indexedDB === 'undefined') return false;
 391: 
 392:     const needsBatches =
 393:       (typeof localStorage !== 'undefined' && !localStorage.getItem(DB_STORAGE_KEY_BATCHES)) ||
 394:       this.corruptedKeysRecovered.includes(DB_STORAGE_KEY_BATCHES);
 395:     const needsLogs =
 396:       (typeof localStorage !== 'undefined' &&
 397:         !localStorage.getItem(DB_STORAGE_KEY_LOGS) &&
 398:         !localStorage.getItem('enology_fermentation_logs_v2')) ||
 399:       this.corruptedKeysRecovered.includes(DB_STORAGE_KEY_LOGS);
 400:     const needsAdditions =
 401:       (typeof localStorage !== 'undefined' && !localStorage.getItem(DB_STORAGE_KEY_ADDITIONS)) ||
 402:       this.corruptedKeysRecovered.includes(DB_STORAGE_KEY_ADDITIONS);
 403:     const needsAnalyses =
 404:       (typeof localStorage !== 'undefined' && !localStorage.getItem(DB_STORAGE_KEY_ANALYSES)) ||
 405:       this.corruptedKeysRecovered.includes(DB_STORAGE_KEY_ANALYSES);
 406:     const needsCalcs =
 407:       (typeof localStorage !== 'undefined' && !localStorage.getItem(DB_STORAGE_KEY_CALCS)) ||
 408:       this.corruptedKeysRecovered.includes(DB_STORAGE_KEY_CALCS);
 409: 
 410:     if (!needsBatches && !needsLogs && !needsAdditions && !needsAnalyses && !needsCalcs) {
 411:       return false;
 412:     }
 413: 
 414:     return new Promise<boolean>((resolve) => {
 415:       try {
 416:         const req = indexedDB.open('enology_studio_idb_v1', 1);
 417:         req.onupgradeneeded = () => {
 418:           const db = req.result;
 419:           if (!db.objectStoreNames.contains('kv_mirror')) {
 420:             db.createObjectStore('kv_mirror');
 421:           }
 422:         };
 423:         req.onerror = () => resolve(false);
 424:         req.onsuccess = () => {
 425:           try {
 426:             const db = req.result;
 427:             if (!db.objectStoreNames.contains('kv_mirror')) {
 428:               resolve(false);
 429:               return;
 430:             }
 431:             const tx = db.transaction('kv_mirror', 'readonly');
 432:             const store = tx.objectStore('kv_mirror');
 433:             let hydratedAny = false;
 434: 
 435:             const readKey = <T>(
 436:               key: string,
 437:               shouldHydrate: boolean,
 438:               schema: z.ZodType<T>,
 439:               onValid: (items: T[]) => void
 440:             ): Promise<void> =>
 441:               new Promise((res) => {
 442:                 if (!shouldHydrate) {
 443:                   res();
 444:                   return;
 445:                 }
 446:                 try {
 447:                   const getReq = store.get(key);
 448:                   getReq.onsuccess = () => {
 449:                     if (this.hasLocalMutations) {
 450:                       res();
 451:                       return;
 452:                     }
 453:                     const val = getReq.result;
 454:                     if (Array.isArray(val) && val.length > 0) {
 455:                       const parsed = z.array(schema).safeParse(val);
 456:                       if (parsed.success && parsed.data.length > 0) {
 457:                         onValid(parsed.data);
 458:                         hydratedAny = true;
 459:                       }
 460:                     }
 461:                     res();
 462:                   };
 463:                   getReq.onerror = () => res();
 464:                 } catch {
 465:                   res();
 466:                 }
 467:               });
 468: 
 469:             const mergeIfSalvaged = <T extends { id: string }>(
 470:               key: string,
 471:               current: T[],
 472:               idbItems: T[]
 473:             ): T[] => {
 474:               if (!this.corruptedKeysRecovered.includes(key) || current.length === 0) {
 475:                 return idbItems;
 476:               }
 477:               const map = new Map<string, T>();
 478:               for (const item of current) {
 479:                 map.set(item.id, item);
 480:               }
 481:               for (const idbItem of idbItems) {
 482:                 if (!map.has(idbItem.id)) {
 483:                   map.set(idbItem.id, idbItem);
 484:                 }
 485:               }
 486:               return Array.from(map.values());
 487:             };
 488: 
 489:             void Promise.all([
 490:               readKey(DB_STORAGE_KEY_BATCHES, needsBatches, WineBatchSchema, (items) => {
 491:                 this.batches = mergeIfSalvaged(DB_STORAGE_KEY_BATCHES, this.batches, items);
 492:                 this.handleStorageSetItem(DB_STORAGE_KEY_BATCHES, JSON.stringify(this.batches));
 493:               }),
 494:               readKey(DB_STORAGE_KEY_LOGS, needsLogs, FermentationLogEntrySchema, (items) => {
 495:                 this.logs = mergeIfSalvaged(DB_STORAGE_KEY_LOGS, this.logs, items);
 496:                 this.handleStorageSetItem(DB_STORAGE_KEY_LOGS, JSON.stringify(this.logs));
 497:               }),
 498:               readKey(DB_STORAGE_KEY_ADDITIONS, needsAdditions, ChemicalAdditionSchema, (items) => {
 499:                 this.additions = mergeIfSalvaged(DB_STORAGE_KEY_ADDITIONS, this.additions, items);
 500:                 this.handleStorageSetItem(DB_STORAGE_KEY_ADDITIONS, JSON.stringify(this.additions));
 501:               }),
 502:               readKey(DB_STORAGE_KEY_ANALYSES, needsAnalyses, LabAnalysisRecordSchema, (items) => {
 503:                 this.analyses = mergeIfSalvaged(DB_STORAGE_KEY_ANALYSES, this.analyses, items);
 504:                 this.handleStorageSetItem(DB_STORAGE_KEY_ANALYSES, JSON.stringify(this.analyses));
 505:               }),
 506:               readKey(DB_STORAGE_KEY_CALCS, needsCalcs, SavedCalculationSchema, (items) => {
 507:                 this.calculations = mergeIfSalvaged(DB_STORAGE_KEY_CALCS, this.calculations, items);
 508:                 this.handleStorageSetItem(DB_STORAGE_KEY_CALCS, JSON.stringify(this.calculations));
 509:               })
 510:             ]).then(() => resolve(hydratedAny));
 511:           } catch {
 512:             resolve(false);
 513:           }
 514:         };
 515:       } catch {
 516:         resolve(false);
 517:       }
 518:     });
 519:   }
 520: 
 521:   private init() {
 522:     if (this.isInitialized) return;
 523: 
 524:     this.loadBackupMeta();
 525: 
 526:     // Load Batches with Row-Level Zod Salvage
 527:     const savedBatches =
 528:       typeof localStorage !== 'undefined' ? localStorage.getItem(DB_STORAGE_KEY_BATCHES) : null;
 529:     if (savedBatches) {
 530:       this.batches = this.parseArrayWithSalvage(
 531:         DB_STORAGE_KEY_BATCHES,
 532:         savedBatches,
 533:         WineBatchSchema,
 534:         DEFAULT_BATCHES
 535:       );
 536:     } else {
 537:       this.batches = [...DEFAULT_BATCHES];
 538:     }
 539: 
 540:     // Load Fermentation Logs with Row-Level Zod Salvage
 541:     const savedLogs =
 542:       typeof localStorage !== 'undefined'
 543:         ? localStorage.getItem(DB_STORAGE_KEY_LOGS) || localStorage.getItem('enology_fermentation_logs_v2')
 544:         : null;
 545:     if (savedLogs) {
 546:       this.logs = this.parseArrayWithSalvage(
 547:         DB_STORAGE_KEY_LOGS,
 548:         savedLogs,
 549:         FermentationLogEntrySchema,
 550:         INITIAL_TRACKING_DATA
 551:       );
 552:     } else {
 553:       this.logs = [...INITIAL_TRACKING_DATA];
 554:     }
 555: 
 556:     // Load Chemical Additions with Row-Level Zod Salvage
 557:     const savedAdditions =
 558:       typeof localStorage !== 'undefined' ? localStorage.getItem(DB_STORAGE_KEY_ADDITIONS) : null;
 559:     if (savedAdditions) {
 560:       this.additions = this.parseArrayWithSalvage(
 561:         DB_STORAGE_KEY_ADDITIONS,
 562:         savedAdditions,
 563:         ChemicalAdditionSchema,
 564:         DEFAULT_CHEMICAL_ADDITIONS
 565:       );
 566:     } else {
 567:       this.additions = [...DEFAULT_CHEMICAL_ADDITIONS];
 568:     }
 569: 
 570:     // Load Lab Analyses with Row-Level Zod Salvage
 571:     const savedAnalyses =
 572:       typeof localStorage !== 'undefined' ? localStorage.getItem(DB_STORAGE_KEY_ANALYSES) : null;
 573:     if (savedAnalyses) {
 574:       this.analyses = this.parseArrayWithSalvage(
 575:         DB_STORAGE_KEY_ANALYSES,
 576:         savedAnalyses,
 577:         LabAnalysisRecordSchema,
 578:         DEFAULT_LAB_ANALYSES
 579:       );
 580:     } else {
 581:       this.analyses = [...DEFAULT_LAB_ANALYSES];
 582:     }
 583: 
 584:     // Load Saved Calculations with Row-Level Zod Salvage
 585:     const savedCalcs =
 586:       typeof localStorage !== 'undefined' ? localStorage.getItem(DB_STORAGE_KEY_CALCS) : null;
 587:     if (savedCalcs) {
 588:       this.calculations = this.parseArrayWithSalvage(
 589:         DB_STORAGE_KEY_CALCS,
 590:         savedCalcs,
 591:         SavedCalculationSchema,
 592:         []
 593:       );
 594:     } else {
 595:       this.calculations = [];
 596:     }
 597: 
 598:     this.isInitialized = true;
 599:     void this.hydrateFromIndexedDBIfNeeded();
 600:   }
