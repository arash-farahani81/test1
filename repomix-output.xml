  81: function generateId(prefix: string): string {
  82:   if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
  83:     return `${prefix}-${crypto.randomUUID()}`;
  84:   }
  85:   return `${prefix}-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
