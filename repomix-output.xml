719: /**
720:  * Calculates dynamic Specific Gravity (SG) trigger thresholds based on actual initial must SG0:
721:  * Formula: SG_trigger = SG0 - f * (SG0 - 1.000)
722:  * - f = 0.10: SNA-1 (10% sugar drop, Fermaid O; 1.083 at SG0=1.092)
723:  * - f = 0.24: SNA-2 (~24% sugar drop, Fermaid K + DAP + Zinc; 1.070 at SG0=1.092 naturally without overrides)
724:  * - f = 0.33: 1/3 Sugar Break Ceiling (strictly last legal window for inorganic DAP / Fermaid K; 1.062 at SG0=1.092)
725:  * - f = 0.35: Phase 2 Red Color Tannin & seed removal (~35% sugar drop; 1.060 at SG0=1.092)
726:  * - f = 0.38: SNA-3 Final Organic Nitrogen Ceiling (100% Organic Fermaid O; 1.057 at SG0=1.092)
727:  */
728: export function calculateDynamicSGTriggers(
729:   initialSG: number = 1.092,
730:   overrides?: { pressingPoint?: number; drynessPoint?: number }
731: ): {
732:   initialSG: number;
733:   sna1: number;
734:   sna2: number;
735:   oneThirdCeiling: number;
736:   phase2Tannin: number;
737:   sna3: number;
738:   pressingPoint: number;
739:   drynessPoint: number;
740: } {
741:   const sg0 = !Number.isFinite(initialSG) || initialSG <= 0 ? 1.092 : Math.max(1.020, initialSG);
742:   const span = sg0 - 1.000;
743:   const pressingPoint = Math.round((overrides?.pressingPoint ?? 1.008) * 1000) / 1000;
744:   const drynessPoint = Math.round((overrides?.drynessPoint ?? 0.993) * 1000) / 1000;
745:   return {
746:     initialSG: Math.round(sg0 * 1000) / 1000,
747:     sna1: Math.round((sg0 - 0.10 * span) * 1000) / 1000,
748:     sna2: Math.round((sg0 - 0.24 * span) * 1000) / 1000,
749:     oneThirdCeiling: Math.round((sg0 - 0.33 * span) * 1000) / 1000,
750:     phase2Tannin: Math.round((sg0 - 0.35 * span) * 1000) / 1000,
751:     sna3: Math.round((sg0 - 0.38 * span) * 1000) / 1000,
752:     pressingPoint,
753:     drynessPoint
754:   };
755: }
756: 
757: /**
758:  * Calculates 3% w/v Food-Grade Hydrogen Peroxide (H2O2, 30 mg/mL) volume in mL required to oxidize excess Free SO2.
759:  * Stoichiometry: SO2 (64.06 g/mol) + H2O2 (34.01 g/mol) -> H2SO4
760:  * 1 mg SO2 requires 34.01 / 64.06 = 0.5309 mg pure H2O2.
761:  * In a 3% w/v solution (30 mg/mL): 0.5309 / 30 = 0.0177 mL of 3% H2O2 per mg SO2.
762:  */
763: export function calculateH2O2SulfiteRemoval(
764:   volumeL: number,
765:   currentSO2: number,
766:   targetSO2: number = 35
767: ): number {
768:   const effectiveTarget = Math.max(10, targetSO2);
769:   if (volumeL <= 0 || currentSO2 <= effectiveTarget) return 0;
770:   const excessSO2 = currentSO2 - effectiveTarget;
771:   const ml3Percent = excessSO2 * 0.0177 * volumeL;
772:   return Math.round(ml3Percent * 100) / 100;
773: }
774: 
775: /**
776:  * Staged H2O2 Sulfite Reduction Plan per AWRI Guidelines:
777:  * - Never reduce Free SO2 below 10 mg/L (clamps effectiveTargetSO2 >= 10)
778:  * - Maximum safe reduction per stage is 25 mg/L SO2
779:  * - Recommends 50% conservative trial step 1 and >3.5x dilution (<1% H2O2) before slow addition
780:  */
781: export function calculateStagedH2O2Plan(
782:   volumeL: number,
783:   currentSO2: number,
784:   targetSO2: number = 35
785: ): {
786:   effectiveTargetSO2: number;
787:   totalExcessSO2MgL: number;
788:   maxSingleStepReductionMgL: number;
789:   currentStepReductionMgL: number;
790:   totalTheoretical3PercentMl: number;
791:   maxCurrentStep3PercentMl: number;
792:   recommendedSafeTrialStep1Ml: number;
793:   dilutedUnder1PercentTotalVolumeMl: number;
794:   stagesRequired: number;
795:   requiresReMeasurementBeforeNextStage: true;
796: } {
797:   const effectiveTargetSO2 = Math.max(10, targetSO2);
798:   const totalExcessSO2MgL = Math.max(0, Math.round((currentSO2 - effectiveTargetSO2) * 10) / 10);
799:   const maxSingleStepReductionMgL = 25;
800:   const currentStepReductionMgL = Math.min(maxSingleStepReductionMgL, totalExcessSO2MgL);
801:   const totalTheoretical3PercentMl = calculateH2O2SulfiteRemoval(volumeL, currentSO2, effectiveTargetSO2);
802:   const maxCurrentStep3PercentMl =
803:     Math.round(currentStepReductionMgL * 0.0177 * Math.max(0, volumeL) * 100) / 100;
804:   const recommendedSafeTrialStep1Ml = Math.round(maxCurrentStep3PercentMl * 0.50 * 100) / 100;
805:   const dilutedUnder1PercentTotalVolumeMl = Math.round(maxCurrentStep3PercentMl * 3.5 * 10) / 10;
806:   const stagesRequired = totalExcessSO2MgL > 0 ? Math.ceil(totalExcessSO2MgL / maxSingleStepReductionMgL) : 0;
807: 
808:   return {
809:     effectiveTargetSO2,
810:     totalExcessSO2MgL,
811:     maxSingleStepReductionMgL,
812:     currentStepReductionMgL,
813:     totalTheoretical3PercentMl,
814:     maxCurrentStep3PercentMl,
815:     recommendedSafeTrialStep1Ml,
816:     dilutedUnder1PercentTotalVolumeMl,
817:     stagesRequired,
818:     requiresReMeasurementBeforeNextStage: true
819:   };
820: }
</file>

