 148: function playTimerCompletionChime() {
 149:   try {
 150:     if (typeof window === 'undefined') return;
 151:     const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
 152:     if (!AudioCtx) return;
 153:     const ctx = new AudioCtx();
 154:     const now = ctx.currentTime;
 155:     [523.25, 659.25, 783.99].forEach((freq, idx) => {
 156:       const osc = ctx.createOscillator();
 157:       const gain = ctx.createGain();
 158:       osc.type = 'sine';
 159:       osc.frequency.setValueAtTime(freq, now + idx * 0.16);
 160:       gain.gain.setValueAtTime(0.12, now + idx * 0.16);
 161:       gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.16 + 0.35);
 162:       osc.connect(gain);
 163:       gain.connect(ctx.destination);
 164:       osc.start(now + idx * 0.16);
 165:       osc.stop(now + idx * 0.16 + 0.36);
 166:     });
 167:   } catch {
 168:     // Ignore audio context restrictions
 169:   }
 170: }
