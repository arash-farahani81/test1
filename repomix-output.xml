638: /**
639:  * Precision Scale & Stock Solution Assistant for micro-doses (e.g., 0.26g Zinc Sulfate on 0.1g or 1g scale).
640:  */
641: export function calculateStockSolutionPlan(
642:   targetDoseGrams: number,
643:   scalePrecisionGrams: ScalePrecisionGrams = 0.1,
644:   compoundCategory: StockCompoundCategory = 'general'
645: ): {
646:   needsStockSolution: boolean;
647:   canUseStockSolution: boolean;
648:   targetDoseGrams: number;
649:   scalePrecisionGrams: ScalePrecisionGrams;
650:   stockMassGrams: number;
651:   stockVolumeMl: number;
652:   syringeVolumeMl: number;
653:   roundedDirectGrams: number;
654:   directWeighErrorPct: number;
655:   instructionFa: string;
656:   stabilityNoteFa: string;
657: } {
658:   const safeTarget = Math.max(0, targetDoseGrams);
659:   const needsStockSolution = safeTarget > 0 && safeTarget < 10 * scalePrecisionGrams;
660:   const canUseStockSolution = compoundCategory !== 'fermaid_or_yeast';
661: 
662:   let stockMassGrams = Math.max(scalePrecisionGrams * 10, 1.0);
663:   if (safeTarget >= stockMassGrams) {
664:     stockMassGrams = Math.ceil(safeTarget / scalePrecisionGrams) * scalePrecisionGrams;
665:   }
666:   const stockVolumeMl = 100;
667:   const syringeVolumeMl =
668:     safeTarget > 0
669:       ? Math.round((safeTarget / (stockMassGrams / stockVolumeMl)) * 10) / 10
670:       : 0;
671: 
672:   const roundedDirectGrams =
673:     safeTarget > 0
674:       ? Math.round(
675:           Math.max(
676:             scalePrecisionGrams,
677:             Math.round(safeTarget / scalePrecisionGrams) * scalePrecisionGrams
678:           ) * 100
679:         ) / 100
680:       : 0;
681: 
682:   const directWeighErrorPct =
683:     safeTarget > 0
684:       ? Math.round((Math.abs(roundedDirectGrams - safeTarget) / safeTarget) * 100)
685:       : 0;
686: 
687:   const instructionFa = !canUseStockSolution
688:     ? `مخمر و مغذی‌های ارگانیک (Fermaid / Go-Ferm) نباید به صورت محلول استوک نگهداری شوند؛ مقدار ${roundedDirectGrams} گرم را مستقیماً وزن و تازه مصرف کنید.`
689:     : `${stockMassGrams} گرم را وزن کرده و در ${stockVolumeMl} میلی‌لیتر آب مقطر حل کنید؛ سپس ${syringeVolumeMl} میلی‌لیتر از آن را با سرنگ بردارید.`;
690: 
691:   let stabilityNoteFa =
692:     'محلول استوک تازه را در ظرف شیشه‌ای تمیز با آب مقطر تهیه کنید.';
693:   if (compoundCategory === 'fermaid_or_yeast') {
694:     stabilityNoteFa =
695:       'ممنوعیت استوک: مخمر و مغذی‌های مخمری (Fermaid O/K, Go-Ferm) سوسپانسیون زیستی هستند و قابلیت نگهداری به صورت محلول استوک را ندارند.';
696:   } else if (compoundCategory === 'kms') {
697:     stabilityNoteFa =
698:       'هشدار پایداری KMS: محلول متابی‌سولفیت پتاسیم به سرعت گاز SO2 آزاد کرده و اکسید می‌شود؛ حتماً در همان روز تهیه و مصرف گردد.';
699:   } else if (compoundCategory === 'zinc' || compoundCategory === 'copper' || compoundCategory === 'tartaric') {
700:     stabilityNoteFa =
701:       'پایداری بالا: محلول استوک املاح معدنی (سولفات روی، سولفات مس) و اسید تارتاریک در بطری دربسته و جای خنک تا ۶ ماه پایدار است.';
702:   }
703: 
704:   return {
705:     needsStockSolution,
706:     canUseStockSolution,
707:     targetDoseGrams: safeTarget,
708:     scalePrecisionGrams,
709:     stockMassGrams,
710:     stockVolumeMl,
711:     syringeVolumeMl,
712:     roundedDirectGrams,
713:     directWeighErrorPct,
714:     instructionFa,
715:     stabilityNoteFa
716:   };
717: }
