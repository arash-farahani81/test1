629: export type ScalePrecisionGrams = 1 | 0.1 | 0.01;
630: export type StockCompoundCategory =
631:   | 'zinc'
632:   | 'kms'
633:   | 'copper'
634:   | 'tartaric'
635:   | 'fermaid_or_yeast'
636:   | 'general';
