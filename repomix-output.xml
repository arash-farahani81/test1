  85: /**
  86:  * Converts Persian/Arabic numerals in a string to ASCII digits and extracts hour fraction if present
  87:  */
  88: function parseTimeHourFromDateTime(dateTime?: string): number | null {
  89:   if (!dateTime) return null;
  90:   const normalized = dateTime
  91:     .replace(/[۰-۹]/g, (d) => String(d.charCodeAt(0) - 1776))
  92:     .replace(/[٠-٩]/g, (d) => String(d.charCodeAt(0) - 1632));
  93:   const match = normalized.match(/(\d{1,2}):(\d{2})/);
  94:   if (!match) return null;
  95:   const hours = parseInt(match[1], 10);
  96:   const minutes = parseInt(match[2], 10);
  97:   if (isNaN(hours) || isNaN(minutes)) return null;
  98:   return hours + minutes / 60;
  99: }
