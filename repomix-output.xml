 145: async function savePhotoToIdb(
 146:   entry: PhotoDiaryEntry
 147: ): Promise<{ success: boolean; error?: string }> {
 148:   const db = await openPhotoIdb();
 149:   if (!db) {
 150:     if (typeof localStorage === 'undefined') {
 151:       return { success: false, error: 'فضای ذخیره‌سازی در دسترس نیست.' };
 152:     }
 153:     try {
 154:       const existing = await getAllPhotosFromIdb();
 155:       localStorage.setItem(
 156:         IDB_FALLBACK_LS_KEY,
 157:         JSON.stringify([entry, ...existing].slice(0, 15))
 158:       );
 159:       return { success: true };
 160:     } catch {
 161:       return { success: false, error: 'سقف حافظه مرورگر تکمیل شده است.' };
 162:     }
 163:   }
 164:   return new Promise((resolve) => {
 165:     try {
 166:       const tx = db.transaction(IDB_STORE_NAME, 'readwrite');
 167:       tx.objectStore(IDB_STORE_NAME).put(entry);
 168:       tx.oncomplete = () => resolve({ success: true });
 169:       tx.onerror = () =>
 170:         resolve({ success: false, error: 'خطا در ذخیره‌سازی IndexedDB.' });
 171:     } catch {
 172:       resolve({ success: false, error: 'خطا در تراکنش IndexedDB.' });
 173:     }
 174:   });
 175: }
