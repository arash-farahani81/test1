 617: function round1(val: number): number {
 618:   return Math.round(val * 10) / 10;
 619: }
 620: 
 621: function round2(val: number): number {
 622:   return Math.round(val * 100) / 100;
 623: }
 624: 
 625: function round3(val: number): number {
 626:   return Math.round(val * 1000) / 1000;
 627: }
 628: 
 629: /**
 630:  * Pure calculation engine that computes the entire winery mass/volume cascade,
 631:  * dynamic SG triggers, nitrogen budget, and 20-row chemical BOM from FlexibleProtocolParams.
 632:  */
 633: export function computeDynamicProtocolPlan(
 634:   overrides?: Partial<FlexibleProtocolParams>
 635: ): DynamicProtocolPlan {
 636:   const params: FlexibleProtocolParams = {
 637:     ...IDEAL_DEFAULT_PROTOCOL_PARAMS,
 638:     ...(overrides || {})
 639:   };
 640: 
 641:   const scaleFactor = Math.max(0.05, params.grapeWeightKg / 400);
 642: 
 643:   // 1. Volumes Cascade
 644:   const totalCrushedMashL = round1(params.mashYieldPer400KgL * scaleFactor);
 645:   const crushedMashPerTankL = round1(totalCrushedMashL / 2);
 646:   const initialLiquidL = round1(params.initialLiquidPer400KgL * scaleFactor);
 647:   const initialLiquidPerTankL = round1(initialLiquidL / 2);
 648:   const saigneeTotalL = round1(params.saigneeTotalL * scaleFactor);
 649:   const saigneePerTankL = round1(saigneeTotalL / 2);
 650:   const roseClarifiedFermentL = round1(params.roseClarifiedFermentL * scaleFactor);
 651:   const rosePostRackingL = round1(params.rosePostRackingL * scaleFactor);
 652:   const roseFinalBottlingL = round1(params.roseFinalBottlingL * scaleFactor);
 653:   const roseBottles750ml = Math.floor((roseFinalBottlingL * 1000) / 750);
 654: 
 655:   const redMashAfterSaigneePerTankL = round1(Math.max(10, crushedMashPerTankL - saigneePerTankL));
 656:   const isCustomYieldFactor =
 657:     params.redMashLiquidYieldFactor !== IDEAL_DEFAULT_PROTOCOL_PARAMS.redMashLiquidYieldFactor;
 658:   const redLiquidFermentPerTankL = isCustomYieldFactor
 659:     ? round1(Math.max(10, redMashAfterSaigneePerTankL * params.redMashLiquidYieldFactor))
 660:     : round1(Math.max(10, initialLiquidPerTankL - saigneePerTankL));
 661:   const redLiquidFermentTotalL = round1(redLiquidFermentPerTankL * 2);
 662: 
 663:   const freeRunPerTankL = round1(params.postPressFreeRunPerTankL * scaleFactor);
 664:   const freeRunTotalL = round1(freeRunPerTankL * 2);
 665:   const rack1PerTankL = round1(params.postPressRack1PerTankL * scaleFactor);
 666:   const rack1TotalL = round1(rack1PerTankL * 2);
 667:   const rack2PerTankL = round1(params.postPressRack2PerTankL * scaleFactor);
 668:   const rack2TotalL = round1(rack2PerTankL * 2);
 669:   const finalRedPerTankL = round1(params.postPressFinalPerTankL * scaleFactor);
 670:   const finalRedTotalL = round1(finalRedPerTankL * 2);
 671:   const redBottles750ml = Math.floor((finalRedTotalL * 1000) / 750);
 672: 
 673:   const heavyPressTotalL = round1(params.heavyPressTotalL * scaleFactor);
 674:   const heavyPressPerTankL = round1(heavyPressTotalL / 2);
 675:   const totalBottles750ml = redBottles750ml + roseBottles750ml;
 676: 
 677:   // 2. Dynamic SG Triggers
 678:   const sg0 =
 679:     !Number.isFinite(params.initialSG) || params.initialSG <= 0
 680:       ? 1.092
 681:       : Math.max(1.020, params.initialSG);
 682:   const span = sg0 - 1.000;
 683:   const triggers = {
 684:     initialSG: round3(sg0),
 685:     sna1: round3(sg0 - 0.10 * span),
 686:     sna2: round3(sg0 - 0.24 * span),
 687:     oneThirdCeiling: round3(sg0 - 0.33 * span),
 688:     phase2Tannin: round3(sg0 - 0.35 * span),
 689:     sna3: round3(sg0 - 0.38 * span),
 690:     pressingSG: round3(params.pressingTargetSG),
 691:     drynessSG: 0.993
 692:   };
 693: 
 694:   // 3. Nitrogen Mass Balance
 695:   const sugarGPerL = round1(params.initialBrix * 10 * sg0);
 696:   const targetYANMgL = Math.round(Math.round(sugarGPerL) * 1.05);
 697:   const neededYANMgL = Math.max(0, targetYANMgL - params.naturalMustYANMgL);
 698:   const yanScale = neededYANMgL / 152; // 152 mg N/L is the 22 Brix / 1.092 SG baseline deficit
 699: 
 700:   // 4. Dosages
 701:   // KMS at crush: 6.52g at 150L & 25 mg/L target (scaled proportionally)
 702:   const crushKmsPerTankG = round2(6.52 * (initialLiquidPerTankL / 150) * (params.crushSO2TargetMgL / 25));
 703:   const postSaigneeKmsPerTankG = round2(
 704:     3.43 * (redLiquidFermentPerTankL / 132) * (params.postSaigneeRedSO2TargetMgL / 40)
 705:   );
 706:   const day11KmsPerTankG = round2(params.day11KmsRateGL * rack1PerTankL);
 707:   const preBottlingKmsPerTankG = round2(0.030 * finalRedPerTankL);
 708:   const rosePostFermKmsG = round2(0.078 * rosePostRackingL);
 709:   const rosePreBottlingKmsG = round2(0.030 * roseFinalBottlingL);
 710:   const heavyPressKmsG = round2(0.078 * heavyPressTotalL);
 711:   const totalWineKmsG = round2(
 712:     (crushKmsPerTankG + postSaigneeKmsPerTankG + day11KmsPerTankG + preBottlingKmsPerTankG) * 2 +
 713:       rosePostFermKmsG +
 714:       rosePreBottlingKmsG +
 715:       heavyPressKmsG
 716:   );
 717: 
 718:   const pecticEnzymeRedPerTankG = round2(params.pecticEnzymeRedRateGL * redLiquidFermentPerTankL);
 719:   const pecticEnzymeRoseG = round2(params.pecticEnzymeRoseRateGL * saigneeTotalL);
 720:   const pecticEnzymeTotalG = round2(pecticEnzymeRedPerTankG * 2 + pecticEnzymeRoseG);
 721: 
 722:   const whiteTanninRedPhase1PerTankG = round2(0.030 * redLiquidFermentPerTankL);
 723:   const whiteTanninRoseFermentG = round2(0.035 * roseClarifiedFermentL);
 724:   const whiteTanninRoseFinishingG = round2(0.015 * roseFinalBottlingL);
 725:   const whiteTanninTotalG = round2(
 726:     whiteTanninRedPhase1PerTankG * 2 + whiteTanninRoseFermentG + whiteTanninRoseFinishingG
 727:   );
 728: 
 729:   const redTanninPhase1PerTankG = round2(0.100 * redLiquidFermentPerTankL);
 730:   const redTanninPhase2PerTankG = round2(0.100 * redLiquidFermentPerTankL);
 731:   const redTanninFinishingPerTankG = round2(0.025 * finalRedPerTankL);
 732:   const redTanninTotalG = round2(
 733:     (redTanninPhase1PerTankG + redTanninPhase2PerTankG + redTanninFinishingPerTankG) * 2
 734:   );
 735: 
 736:   const yeastRedPerTankG = round2(params.yeastRateGL * redLiquidFermentPerTankL);
 737:   const yeastRoseG = round2(params.yeastRateGL * roseClarifiedFermentL);
 738:   const yeastTotalG = round2(yeastRedPerTankG * 2 + yeastRoseG);
 739: 
 740:   const goFermRedPerTankG = round2(yeastRedPerTankG * params.goFermMultiplier);
 741:   const goFermRoseG = round2(yeastRoseG * params.goFermMultiplier);
 742:   const goFermTotalG = round2(goFermRedPerTankG * 2 + goFermRoseG);
 743: 
 744:   const fermaidO1RedPerTankG = round2(params.fermaidO1RedRateGL * yanScale * redLiquidFermentPerTankL);
 745:   const fermaidO1RoseG = round2(params.fermaidO1RoseRateGL * yanScale * roseClarifiedFermentL);
 746:   const fermaidO3RedPerTankG = round2(params.fermaidO3RedRateGL * yanScale * redLiquidFermentPerTankL);
 747:   const fermaidO3RoseG = round2(params.fermaidO3RoseRateGL * yanScale * roseClarifiedFermentL);
 748:   const fermaidOTotalG = round2(
 749:     (fermaidO1RedPerTankG + fermaidO3RedPerTankG) * 2 + fermaidO1RoseG + fermaidO3RoseG
 750:   );
 751: 
 752:   const fermaidK2RedPerTankG = round2(params.fermaidK2RedRateGL * yanScale * redLiquidFermentPerTankL);
 753:   const fermaidK2RoseG = round2(params.fermaidK2RoseRateGL * yanScale * roseClarifiedFermentL);
 754:   const fermaidKTotalG = round2(fermaidK2RedPerTankG * 2 + fermaidK2RoseG);
 755: 
 756:   const dap2RedPerTankG = round2(params.dap2RedRateGL * yanScale * redLiquidFermentPerTankL);
 757:   const dap2RoseG = round2(params.dap2RoseRateGL * yanScale * roseClarifiedFermentL);
 758:   const dapTotalG = round2(dap2RedPerTankG * 2 + dap2RoseG);
 759: 
 760:   const zincRedPerTankG = round2(params.zincSafeRateGL * redLiquidFermentPerTankL);
 761:   const zincRoseG = round2(
 762:     (params.presetId === 'classic_v32' ? 0.015 : params.zincSafeRateGL) * roseClarifiedFermentL
 763:   );
 764:   const zincTotalG = round2(zincRedPerTankG * 2 + zincRoseG);
 765: 
 766:   const bentoniteRoseG = round2(0.20 * saigneeTotalL);
 767: 
 768:   const bactilessRedPerTankG = round2(params.bactilessRedRateGL * rack1PerTankL);
 769:   const bactilessRoseG = round2(params.bactilessRoseRateGL * rosePostRackingL);
 770:   const bactilessHeavyPressG = round2(params.bactilessRedRateGL * heavyPressTotalL);
 771:   const bactilessTotalG = round2(bactilessRedPerTankG * 2 + bactilessRoseG + bactilessHeavyPressG);
 772: 
 773:   const khtColdStabRedPerTankG = round2(0.20 * finalRedPerTankL);
 774:   const khtColdStabRoseG = round2(0.20 * rosePostRackingL);
 775:   const khtColdStabHeavyPressG = round2(0.20 * heavyPressTotalL);
 776:   const khtTotalG = round2(khtColdStabRedPerTankG * 2 + khtColdStabRoseG + khtColdStabHeavyPressG);
 777: 
 778:   const glycerinRedMaxPerTankG = round1(params.redMaxGlycerinGL * finalRedPerTankL);
 779:   const glycerinRoseMaxG = round1(params.roseMaxGlycerinGL * roseFinalBottlingL);
 780:   const glycerinTotalMaxG = round1(glycerinRedMaxPerTankG * 2 + glycerinRoseMaxG);
 781: 
 782:   const ascorbicRedPerTankG = round2(params.ascorbicRateGL * finalRedPerTankL);
 783:   const ascorbicRoseG = round2(params.ascorbicRateGL * roseFinalBottlingL);
 784:   const ascorbicTotalG = round2(ascorbicRedPerTankG * 2 + ascorbicRoseG + 1.0); // +1.0g for Stock #2B
 785: 
 786:   const suppliedChemicalYANRedMgL =
 787:     redLiquidFermentPerTankL > 0
 788:       ? round1(
 789:           (((fermaidO1RedPerTankG + fermaidO3RedPerTankG) *
 790:             MASTER_PROTOCOL_CONFIG.stoichiometry.fermaidOChemicalNitrogenMgPerG +
 791:             fermaidK2RedPerTankG * MASTER_PROTOCOL_CONFIG.stoichiometry.fermaidKNitrogenMgPerG +
 792:             dap2RedPerTankG * MASTER_PROTOCOL_CONFIG.stoichiometry.dapNitrogenMgPerG) /
 793:             redLiquidFermentPerTankL)
 794:         )
 795:       : 0;
 796: 
 797:   const suppliedBioEquivalentYANRedMgL =
 798:     redLiquidFermentPerTankL > 0
 799:       ? round1(
 800:           (((fermaidO1RedPerTankG + fermaidO3RedPerTankG) *
 801:             MASTER_PROTOCOL_CONFIG.stoichiometry.fermaidOBioEquivalentNitrogenMgPerG +
 802:             fermaidK2RedPerTankG * MASTER_PROTOCOL_CONFIG.stoichiometry.fermaidKNitrogenMgPerG +
 803:             dap2RedPerTankG * MASTER_PROTOCOL_CONFIG.stoichiometry.dapNitrogenMgPerG) /
 804:             redLiquidFermentPerTankL)
 805:         )
 806:       : 0;
 807: 
 808:   const baseBioEquivalentYANMgL = round1(
 809:     (params.fermaidO1RedRateGL + params.fermaidO3RedRateGL) *
 810:       MASTER_PROTOCOL_CONFIG.stoichiometry.fermaidOBioEquivalentNitrogenMgPerG +
 811:       params.fermaidK2RedRateGL * MASTER_PROTOCOL_CONFIG.stoichiometry.fermaidKNitrogenMgPerG +
 812:       params.dap2RedRateGL * MASTER_PROTOCOL_CONFIG.stoichiometry.dapNitrogenMgPerG
 813:   );
 814: 
 815:   const unmetBioEquivalentYANMgL = Math.max(
 816:     0,
 817:     round1(neededYANMgL - suppliedBioEquivalentYANRedMgL)
 818:   );
 819: 
 820:   const yanAccountingBasisFa = `کسری نیتروژن هدف (${neededYANMgL} mg N/L) بر پایه ضریب مقیاس YAN تامین میشود: نیتروژن شیمیایی مستقیم = ${suppliedChemicalYANRedMgL} mg N/L، نیتروژن معادل زیستی (با ضریب ۳ برابری اسیدهای آمینه Fermaid O) = ${suppliedBioEquivalentYANRedMgL} mg N eq/L (نرخ پایه پروتکل: ${baseBioEquivalentYANMgL} mg N eq/L) و کسری پوشش‌داده‌نشده (Unmet Bio-Equivalent Deficit) = ${unmetBioEquivalentYANMgL} mg N eq/L.`;
 821: 
 822:   const dynamicVolumeBalances: VolumeBalance[] = [
 823:     {
 824:       stage: 'مادهٔ اولیه',
 825:       volume: `${params.grapeWeightKg} کیلوگرم انگور دست‌چین`,
 826:       description: `بریکس هدف: ${params.initialBrix}، وزن مخصوص اولیه در ۲۰ درجه: SG₀ = ${triggers.initialSG.toFixed(3)}`
 827:     },
 828:     {
 829:       stage: 'حجم کل تودهٔ کراش‌شده',
 830:       volume: `حدود ${totalCrushedMashL} لیتر`,
 831:       description: `تقسیم متقارن: ${crushedMashPerTankL} لیتر در مخزن A و ${crushedMashPerTankL} لیتر در مخزن B`
 832:     },
 833:     {
 834:       stage: 'حجم کل فاز مایع اولیه (V_initial)',
 835:       volume: `${initialLiquidL} لیتر مایع خالص`,
 836:       description: `${initialLiquidPerTankL} لیتر مایع در مخزن A + ${initialLiquidPerTankL} لیتر مایع در مخزن B`
 837:     },
 838:     {
 839:       stage: 'خون‌گیری سانیه برای رُزه (ساعت ۰۳:۰۰)',
 840:       volume: `${saigneeTotalL} لیتر شیرهٔ رُزه`,
 841:       description: `${saigneePerTankL}L از مخزن A + ${saigneePerTankL}L از مخزن B (پس از Débourbage: ${roseClarifiedFermentL}L تخمیری ← ${roseFinalBottlingL}L رُزه نهایی = ${roseBottles750ml} بطری ۷۵۰mL)`
 842:     },
 843:     {
 844:       stage: 'حجم مایع قرمز پس از سانیه (V_red-ferm)',
 845:       volume: `${redLiquidFermentTotalL} لیتر مایع کل`,
 846:       description: `${redLiquidFermentPerTankL}L در مخزن A + ${redLiquidFermentPerTankL}L در مخزن B (حجم مش هر مخزن = ${redMashAfterSaigneePerTankL}L؛ ضریب مایع به مش = ${params.redMashLiquidYieldFactor})`
 847:     },
 848:     {
 849:       stage: `موازنه در ایستگاه پرسینگ (روز ۶ در SG = ${triggers.pressingSG.toFixed(3)})`,
 850:       volume: `${freeRunTotalL}L آب‌آزاد + ${heavyPressTotalL}L پرس سنگین`,
 851:       description: `${freeRunPerTankL}L آب‌آزاد در هر مخزن + ${heavyPressPerTankL}L پرس سنگین در هر مخزن`
 852:     },
 853:     {
