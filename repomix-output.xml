<file path="src/utils/useLocalStorage.ts">
  1: import { useState, useEffect, useRef } from 'react';
  2: 
  3: const LOCAL_STORAGE_SYNC_EVENT = 'enology-localstorage-sync';
  4: 
  5: interface LocalStorageSyncDetail {
  6:   key: string;
  7:   serialized: string;
  8:   value: unknown;
  9: }
 10: 
 11: /**
 12:  * Custom React hook for auto-saving form values and UI states to LocalStorage
 13:  * with same-window ('enology-localstorage-sync') and cross-tab ('storage') synchronization.
 14:  */
 15: export function useLocalStorageState<T>(
 16:   key: string,
 17:   defaultValue: T
 18: ): [T, (value: T | ((prev: T) => T)) => void] {
 19:   const readKey = (targetKey: string, fallback: T): T => {
 20:     if (typeof window === 'undefined' || typeof localStorage === 'undefined') {
 21:       return fallback;
 22:     }
 23:     try {
 24:       const saved = localStorage.getItem(targetKey);
 25:       if (saved !== null) {
 26:         return JSON.parse(saved) as T;
 27:       }
 28:     } catch (e) {
 29:       console.warn(`Error reading LocalStorage key "${targetKey}":`, e);
 30:     }
 31:     return fallback;
 32:   };
 33: 
 34:   const [state, setState] = useState<T>(() => readKey(key, defaultValue));
 35:   const prevKeyRef = useRef<string>(key);
 36:   const lastSerializedRef = useRef<string>(JSON.stringify(state));
 37: 
 38:   useEffect(() => {
 39:     if (typeof window === 'undefined' || typeof localStorage === 'undefined') return;
 40:     if (prevKeyRef.current !== key) {
 41:       prevKeyRef.current = key;
 42:       const nextVal = readKey(key, defaultValue);
 43:       lastSerializedRef.current = JSON.stringify(nextVal);
 44:       setState(nextVal);
 45:       return;
 46:     }
 47:     try {
 48:       const serialized = JSON.stringify(state);
 49:       const currentStored = localStorage.getItem(key);
 50:       if (lastSerializedRef.current !== serialized || currentStored !== serialized) {
 51:         lastSerializedRef.current = serialized;
 52:         localStorage.setItem(key, serialized);
 53:         window.dispatchEvent(
 54:           new CustomEvent<LocalStorageSyncDetail>(LOCAL_STORAGE_SYNC_EVENT, {
 55:             detail: { key, serialized, value: state }
 56:           })
 57:         );
 58:       }
 59:     } catch (e) {
 60:       console.warn(`Error writing LocalStorage key "${key}":`, e);
 61:     }
 62:   }, [key, state]);
 63: 
 64:   useEffect(() => {
 65:     if (typeof window === 'undefined') return;
 66: 
 67:     const handleSameWindowSync = (e: Event) => {
 68:       const customEvent = e as CustomEvent<LocalStorageSyncDetail>;
 69:       const detail = customEvent.detail;
 70:       if (!detail || detail.key !== key) return;
 71:       try {
 72:         const incomingSerialized =
 73:           typeof detail.serialized === 'string'
 74:             ? detail.serialized
 75:             : JSON.stringify(detail.value);
 76:         if (incomingSerialized !== lastSerializedRef.current) {
 77:           lastSerializedRef.current = incomingSerialized;
 78:           setState(
 79:             detail.value !== undefined
 80:               ? (detail.value as T)
 81:               : (JSON.parse(incomingSerialized) as T)
 82:           );
 83:         }
 84:       } catch (err) {
 85:         console.warn(`Error syncing LocalStorage key "${key}":`, err);
 86:       }
 87:     };
 88: 
 89:     const handleStorageEvent = (e: StorageEvent) => {
 90:       if (e.key !== key || e.newValue === null) return;
 91:       try {
 92:         if (e.newValue !== lastSerializedRef.current) {
 93:           lastSerializedRef.current = e.newValue;
 94:           setState(JSON.parse(e.newValue) as T);
 95:         }
 96:       } catch (err) {
 97:         console.warn(`Error handling cross-tab storage event for "${key}":`, err);
 98:       }
 99:     };
100: 
101:     window.addEventListener(LOCAL_STORAGE_SYNC_EVENT, handleSameWindowSync);
102:     window.addEventListener('storage', handleStorageEvent);
103:     return () => {
104:       window.removeEventListener(LOCAL_STORAGE_SYNC_EVENT, handleSameWindowSync);
105:       window.removeEventListener('storage', handleStorageEvent);
106:     };
107:   }, [key]);
108: 
109:   return [state, setState];
110: }
</file>

<file path="src/utils/useToast.ts">
 1: import { useState, useRef, useCallback, useEffect } from 'react';
 2: 
 3: /**
 4:  * Shared Leak-Free Toast Hook (BUG-101, BUG-110)
 5:  * Manages transient toast notifications with automatic timeout cleanup on re-trigger and unmount.
 6:  */
 7: export function useToast(durationMs: number = 3500): {
 8:   toastMessage: string | null;
 9:   showToast: (message: string) => void;
10:   dismissToast: () => void;
11: } {
12:   const [toastMessage, setToastMessage] = useState<string | null>(null);
13:   const timerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
14: 
15:   const dismissToast = useCallback(() => {
16:     if (timerRef.current !== null) {
17:       clearTimeout(timerRef.current);
18:       timerRef.current = null;
19:     }
20:     setToastMessage(null);
21:   }, []);
22: 
23:   const showToast = useCallback(
24:     (message: string) => {
25:       if (timerRef.current !== null) {
26:         clearTimeout(timerRef.current);
27:       }
28:       setToastMessage(message);
29:       timerRef.current = setTimeout(() => {
30:         setToastMessage(null);
31:         timerRef.current = null;
32:       }, durationMs);
33:     },
34:     [durationMs]
35:   );
36: 
37:   useEffect(() => {
38:     return () => {
39:       if (timerRef.current !== null) {
40:         clearTimeout(timerRef.current);
41:       }
42:     };
43:   }, []);
44: 
45:   return { toastMessage, showToast, dismissToast };
46: }
</file>

