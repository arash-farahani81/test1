328: /**
329:  * Live PubChem REST API Compound Fetcher with Retry & Rate Limiting
330:  */
331: export async function fetchPubChemCompoundLive(cidOrName: string | number): Promise<Partial<PubChemCompoundData> | null> {
332:   const controller = new AbortController();
333:   const timeoutId = setTimeout(() => controller.abort(), 8000);
334:   try {
335:     const isCid = typeof cidOrName === 'number' || /^\d+$/.test(String(cidOrName));
336:     const endpoint = isCid
337:       ? `https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/cid/${cidOrName}/property/Title,IUPACName,MolecularFormula,MolecularWeight,CanonicalSMILES,XLogP,TPSA,HBondDonorCount,HBondAcceptorCount,Charge/JSON`
338:       : `https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/name/${encodeURIComponent(cidOrName)}/property/Title,IUPACName,MolecularFormula,MolecularWeight,CanonicalSMILES,XLogP,TPSA,HBondDonorCount,HBondAcceptorCount,Charge/JSON`;
339: 
340:     const res = await fetch(endpoint, {
341:       headers: { Accept: 'application/json' },
342:       signal: controller.signal
343:     });
344:     if (!res.ok) return null;
345:     const json = await res.json();
346:     const prop = json?.PropertyTable?.Properties?.[0];
347:     if (!prop) return null;
348: 
349:     return {
350:       cid: prop.CID,
351:       title: prop.Title || String(cidOrName),
352:       iupacName: prop.IUPACName || '',
353:       molecularFormula: prop.MolecularFormula || '',
354:       molecularWeight: String(prop.MolecularWeight || ''),
355:       canonicalSmiles: prop.CanonicalSMILES || '',
356:       xLogP: prop.XLogP,
357:       tpsa: prop.TPSA,
358:       hBondDonorCount: prop.HBondDonorCount,
359:       hBondAcceptorCount: prop.HBondAcceptorCount,
360:       imageUrl: `https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/cid/${prop.CID}/PNG?image_size=large`
361:     };
362:   } catch (err) {
363:     console.warn('PubChem query fallback:', err);
364:     return null;
365:   } finally {
366:     clearTimeout(timeoutId);
367:   }
368: }
