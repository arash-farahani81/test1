182: /**
183:  * Pure helper: adapts tank selection when batch has tankCount === 1.
184:  * When tankCount === 1, 'tank-b' and 'both-red' automatically adapt to 'tank-a'.
185:  */
186: export function resolveEffectiveTankSelection(
187:   selection: GlobalTankSelection,
188:   tankCount: 1 | 2 = 2
189: ): GlobalTankSelection {
190:   if (tankCount === 1 && (selection === 'tank-b' || selection === 'both-red')) {
191:     return 'tank-a';
192:   }
193:   return selection;
194: }
195: 
196: /**
197:  * Pure helper: maps GlobalTankSelection to a single primary TankId
198:  * for calculators/charts that require a concrete TankId.
199:  */
200: export function resolvePrimaryTankId(
201:   selection: GlobalTankSelection,
202:   tankCount: 1 | 2 = 2
203: ): TankId {
204:   const effective = resolveEffectiveTankSelection(selection, tankCount);
205:   if (effective === 'both-red') {
206:     return 'tank-a';
207:   }
208:   return effective;
209: }
210: 
211: /**
212:  * Pure helper: maps GlobalTankSelection to the array of concrete TankIds
213:  * targeted by batch/tank operations (e.g., logging or recording additions to both red tanks).
214:  */
215: export function resolveTargetTankIds(
216:   selection: GlobalTankSelection,
217:   tankCount: 1 | 2 = 2
218: ): TankId[] {
219:   const effective = resolveEffectiveTankSelection(selection, tankCount);
220:   if (effective === 'both-red') {
221:     return tankCount === 1 ? ['tank-a'] : ['tank-a', 'tank-b'];
222:   }
223:   return [effective];
224: }
