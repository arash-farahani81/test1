567: /**
568:  * Returns the pH-dependent Target Free SO2 (mg/L) range and target value
569:  * required to maintain 0.6–0.8 mg/L Molecular SO2 antimicrobial protection.
570:  */
571: export function getTargetFreeSO2ByPH(
572:   ph: number,
573:   isRose: boolean = false
574: ): { min: number; max: number; target: number } {
575:   void isRose;
576:   if (ph <= 3.30) return { min: 20, max: 26, target: 24 };
577:   if (ph <= 3.40) return { min: 24, max: 32, target: 28 };
578:   if (ph <= 3.50) return { min: 30, max: 40, target: 35 };
579:   if (ph <= 3.60) return { min: 37, max: 49, target: 42 };
580:   const clampedPH = Math.min(4.2, ph);
581:   const hhRatio =
582:     (1 + Math.pow(10, clampedPH - 1.81)) / (1 + Math.pow(10, 3.60 - 1.81));
583:   return {
584:     min: Math.round(37 * hhRatio),
585:     max: Math.round(49 * hhRatio),
586:     target: Math.round(42 * hhRatio)
587:   };
588: }
