 211: export function compressImageToJpeg1280(
 212:   file: File
 213: ): Promise<{ dataUrl: string; sizeKb: number }> {
 214:   return new Promise((resolve, reject) => {
 215:     const reader = new FileReader();
 216:     reader.onerror = () => reject(new Error('خطا در خواندن فایل تصویر'));
 217:     reader.onload = () => {
 218:       const img = new Image();
 219:       img.onerror = () => reject(new Error('فرمت تصویر نامعتبر است'));
 220:       img.onload = () => {
 221:         const maxDim = 1280;
 222:         let width = img.width;
 223:         let height = img.height;
 224:         if (width > maxDim || height > maxDim) {
 225:           if (width >= height) {
 226:             height = Math.round((height * maxDim) / width);
 227:             width = maxDim;
 228:           } else {
 229:             width = Math.round((width * maxDim) / height);
 230:             height = maxDim;
 231:           }
 232:         }
 233:         const canvas = document.createElement('canvas');
 234:         canvas.width = width;
 235:         canvas.height = height;
 236:         const ctx = canvas.getContext('2d');
 237:         if (!ctx) {
 238:           reject(new Error('خطا در پردازش گرافیکی تصویر'));
 239:           return;
 240:         }
 241:         ctx.drawImage(img, 0, 0, width, height);
 242:         const dataUrl = canvas.toDataURL('image/jpeg', 0.7);
 243:         const sizeKb = Math.round((dataUrl.length * 0.75) / 1024);
 244:         resolve({ dataUrl, sizeKb });
 245:       };
 246:       img.src = String(reader.result);
 247:     };
 248:     reader.readAsDataURL(file);
 249:   });
 250: }
