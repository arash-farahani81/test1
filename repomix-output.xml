  99: function openPhotoIdb(): Promise<IDBDatabase | null> {
 100:   return new Promise((resolve) => {
 101:     if (typeof indexedDB === 'undefined') {
 102:       resolve(null);
 103:       return;
 104:     }
 105:     try {
 106:       const req = indexedDB.open(IDB_DB_NAME, 1);
 107:       req.onupgradeneeded = () => {
 108:         const db = req.result;
 109:         if (!db.objectStoreNames.contains(IDB_STORE_NAME)) {
 110:           db.createObjectStore(IDB_STORE_NAME, { keyPath: 'id' });
 111:         }
 112:       };
 113:       req.onsuccess = () => resolve(req.result);
 114:       req.onerror = () => resolve(null);
 115:     } catch {
 116:       resolve(null);
 117:     }
 118:   });
 119: }
