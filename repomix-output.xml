1438:   // --- Import Database (JSON) with Zod Validation ---
1439:   public importDatabaseJSON(
1440:     jsonString: string,
1441:     mode: 'replace' | 'merge' = 'replace'
1442:   ): { success: boolean; message: string } {
1443:     try {
1444:       const parsedObj: unknown = JSON.parse(jsonString);
1445:       const result = EnologyDatabaseExportSchema.safeParse(parsedObj);
1446: 
1447:       if (!result.success) {
1448:         return {
1449:           success: false,
1450:           message: 'فایل پشتیبان نامعتبر است: ساختار داده با پروتکل کارخانه همخوانی ندارد.'
1451:         };
1452:       }
1453: 
1454:       const mergeById = <T extends { id: string }>(existing: T[], incoming: T[]): T[] => {
1455:         const map = new Map<string, T>();
1456:         for (const item of existing) {
1457:           map.set(item.id, item);
1458:         }
1459:         for (const incomingItem of incoming) {
1460:           const existingItem = map.get(incomingItem.id);
1461:           if (!existingItem) {
1462:             map.set(incomingItem.id, incomingItem);
1463:             continue;
1464:           }
1465:           const existingTime =
1466:             (existingItem as { updatedAtMs?: number; timestampMs?: number }).updatedAtMs ??
1467:             (existingItem as { timestampMs?: number }).timestampMs ??
1468:             0;
1469:           const incomingTime =
1470:             (incomingItem as { updatedAtMs?: number; timestampMs?: number }).updatedAtMs ??
1471:             (incomingItem as { timestampMs?: number }).timestampMs ??
1472:             0;
1473: 
1474:           if (existingTime > incomingTime) {
1475:             map.set(incomingItem.id, existingItem);
1476:           } else if (
1477:             (existingItem as { isDeleted?: boolean }).isDeleted === true &&
1478:             (incomingItem as { isDeleted?: boolean }).isDeleted !== true &&
1479:             incomingTime <= existingTime
1480:           ) {
1481:             map.set(incomingItem.id, existingItem);
1482:           } else {
1483:             map.set(incomingItem.id, incomingItem);
1484:           }
1485:         }
1486:         return Array.from(map.values());
1487:       };
1488: 
1489:       this.hasLocalMutations = true;
1490:       if (mode === 'merge') {
1491:         this.batches = mergeById(this.batches, result.data.batches);
1492:         this.logs = mergeById(this.logs, result.data.fermentationLogs);
1493:         this.additions = mergeById(this.additions, result.data.chemicalAdditions);
1494:         this.analyses = mergeById(this.analyses, result.data.labAnalyses);
1495:         this.calculations = mergeById(this.calculations, result.data.savedCalculations);
1496:         if (
1497:           result.data.flexibleProtocolParams &&
1498:           typeof localStorage !== 'undefined' &&
1499:           !localStorage.getItem('enology_flexible_protocol_params_v1')
1500:         ) {
1501:           this.handleStorageSetItem(
1502:             'enology_flexible_protocol_params_v1',
1503:             JSON.stringify(result.data.flexibleProtocolParams)
1504:           );
1505:         }
1506:         this.incrementChangesSinceBackup();
1507:       } else {
1508:         this.batches = result.data.batches;
1509:         this.logs = result.data.fermentationLogs;
1510:         this.additions = result.data.chemicalAdditions;
1511:         this.analyses = result.data.labAnalyses;
1512:         this.calculations = result.data.savedCalculations;
1513:         if (result.data.flexibleProtocolParams) {
1514:           this.handleStorageSetItem(
1515:             'enology_flexible_protocol_params_v1',
1516:             JSON.stringify(result.data.flexibleProtocolParams)
1517:           );
1518:         }
1519:       }
1520: 
1521:       this.persistBatches();
1522:       this.persistLogs();
1523:       this.persistAdditions();
1524:       this.persistAnalyses();
1525:       this.persistCalculations();
1526: 
1527:       return {
1528:         success: true,
1529:         message:
1530:           mode === 'merge'
1531:             ? `پایگاه داده با موفقیت ادغام شد (${this.logs.length} لاگ، ${this.batches.length} بچ)`
1532:             : `پایگاه داده با موفقیت بازنشانی و بارگذاری شد (${result.data.fermentationLogs.length} لاگ، ${result.data.batches.length} بچ)`
1533:       };
1534:     } catch {
1535:       return {
1536:         success: false,
1537:         message: 'فایل پشتیبان نامعتبر است: ساختار داده با پروتکل کارخانه همخوانی ندارد.'
1538:       };
1539:     }
1540:   }
