 650:   public syncActiveBatchProtocolSnapshot(params: FlexibleProtocolParams): WineBatch | null {
 651:     const storedActiveBatchId =
 652:       typeof localStorage !== 'undefined'
 653:         ? localStorage.getItem('enology_ui_active_batch_v1')
 654:         : null;
 655:     const targetBatch =
 656:       (storedActiveBatchId
 657:         ? this.batches.find((b) => b.id === storedActiveBatchId)
 658:         : undefined) ??
 659:       this.batches.find((b) => !b.isDemo) ??
 660:       this.batches[0];
 661:     if (!targetBatch) return null;
 662:     return this.updateBatchProtocolSnapshot(targetBatch.id, params);
