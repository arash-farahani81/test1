 714: export interface FermentationPredictionResult {
 715:   currentSG: number;
 716:   targetSG: number;
 717:   sgRemaining: number;
 718:   recentVelocityPerDay: number; // e.g. 0.012 SG drop per day
 719:   tempKineticFactor: number; // e.g. 1.10x multiplier based on temp
 720:   effectiveVelocityPerDay: number;
 721:   estimatedRemainingDays: number; // e.g. 3.5 days
 722:   estimatedRemainingHours: number; // e.g. 84 hours
 723:   estimatedDaysRange: { min: number; max: number };
 724:   stageName: string; // e.g. "پایان تخمیر اولیه و خشکی کامل (SG = 0.993)"
 725:   kineticStatus: 'fast' | 'normal' | 'sluggish' | 'stuck' | 'finished';
 726:   kineticStatusFa: string;
 727:   kineticAdviceFa: string;
 728:   tempImpactDescription: string;
 729:   isOutOfModelBounds?: boolean;
