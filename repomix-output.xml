 375:   const escapeIcs = (s: string) =>
 376:     s
 377:       .replace(/\\/g, '\\\\')
 378:       .replace(/;/g, '\\;')
 379:       .replace(/,/g, '\\,')
 380:       .replace(/\n/g, '\\n');
 381: 
 382:   const lines: string[] = [
 383:     'BEGIN:VCALENDAR',
 384:     'VERSION:2.0',
 385:     'PRODID:-//Enology Studio//Rasha Sardasht Protocol//FA',
 386:     'CALSCALE:GREGORIAN',
 387:     'METHOD:PUBLISH',
 388:     'X-WR-TIMEZONE:Asia/Tehran'
 389:   ];
 390: 
 391:   for (const ev of events) {
 392:     lines.push('BEGIN:VEVENT');
 393:     lines.push(`UID:${ev.uid}`);
 394:     lines.push(`DTSTART;TZID=Asia/Tehran:${ev.dtStart}`);
 395:     lines.push(`DTEND;TZID=Asia/Tehran:${ev.dtEnd}`);
 396:     if (ev.rrule) {
 397:       lines.push(ev.rrule);
 398:     }
 399:     lines.push(`SUMMARY:${escapeIcs(ev.summary)}`);
 400:     lines.push(`DESCRIPTION:${escapeIcs(ev.description)}`);
 401:     lines.push('BEGIN:VALARM');
 402:     lines.push('TRIGGER:-PT15M');
 403:     lines.push('ACTION:DISPLAY');
 404:     lines.push(`DESCRIPTION:${escapeIcs(ev.summary)}`);
 405:     lines.push('END:VALARM');
 406:     lines.push('END:VEVENT');
 407:   }
 408: 
 409:   lines.push('END:VCALENDAR');
 410:   return lines.join('\r\n');
 411: }
