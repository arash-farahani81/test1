  57: function mirrorToIndexedDB(storeKey: string, data: unknown): void {
  58:   if (typeof indexedDB === 'undefined') return;
  59:   try {
  60:     const req = indexedDB.open('enology_studio_idb_v1', 1);
  61:     req.onupgradeneeded = () => {
  62:       const db = req.result;
  63:       if (!db.objectStoreNames.contains('kv_mirror')) {
  64:         db.createObjectStore('kv_mirror');
  65:       }
  66:     };
  67:     req.onsuccess = () => {
  68:       try {
  69:         const db = req.result;
  70:         const tx = db.transaction('kv_mirror', 'readwrite');
  71:         tx.objectStore('kv_mirror').put(data, storeKey);
  72:       } catch {
  73:         // Ignore non-critical IndexedDB transaction errors
  74:       }
  75:     };
  76:   } catch {
  77:     // Ignore IndexedDB errors in restricted environments
  78:   }
  79: }
