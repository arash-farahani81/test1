 743:   public assignOrphanRecordsToBatch(targetBatchId: string): void {
 744:     const validBatchIds = new Set(this.batches.map((b) => b.id));
 745:     const now = Date.now();
 746:     let changed = false;
 747: 
 748:     this.logs = this.logs.map((l) => {
 749:       if (!l.isDeleted && !l.isBenchmark && (!l.batchId || !validBatchIds.has(l.batchId))) {
 750:         changed = true;
 751:         return { ...l, batchId: targetBatchId, updatedAtMs: now };
 752:       }
 753:       return l;
 754:     });
 755: 
 756:     this.additions = this.additions.map((a) => {
 757:       if (!a.isDeleted && (!a.batchId || !validBatchIds.has(a.batchId))) {
 758:         changed = true;
 759:         return { ...a, batchId: targetBatchId, updatedAtMs: now };
 760:       }
 761:       return a;
 762:     });
 763: 
 764:     this.analyses = this.analyses.map((a) => {
