546: /**
547:  * Dry ice calculation for urgent cooling of must/cap
548:  * Specific heat of must ~ 3.9 kJ/kg*°C, Must mass = Volume (L) * SG (kg/L, default 1.080),
549:  * Dry ice sublimation heat ~ 571 kJ/kg, Heat transfer efficiency ~ 65% (0.65)
550:  */
551: export function calculateCoolingDryIceKg(
552:   volumeL: number,
553:   currentTempC: number,
554:   targetTempC: number = 26,
555:   sg: number = 1.080,
556:   efficiency: number = 0.65
557: ): number {
558:   if (volumeL <= 0 || currentTempC <= targetTempC) return 0;
559:   const effectiveSG = sg > 0 ? sg : 1.080;
560:   const effectiveEfficiency = efficiency > 0 && efficiency <= 1 ? efficiency : 0.65;
561:   const deltaT = currentTempC - targetTempC;
562:   const heatToExtractKJ = volumeL * effectiveSG * 3.9 * deltaT;
563:   const dryIceKg = heatToExtractKJ / (571 * effectiveEfficiency);
564:   return Math.round(dryIceKg * 100) / 100;
565: }
