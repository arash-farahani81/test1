  1: import fs from 'node:fs';
  2: import path from 'node:path';
  3: 
  4: const ROOT = process.cwd();
  5: 
  6: function readSafe(relPath: string): string {
  7:   const fullPath = path.join(ROOT, relPath);
  8:   if (!fs.existsSync(fullPath)) {
  9:     return `<!-- File not found: ${relPath} -->`;
 10:   }
 11:   return fs.readFileSync(fullPath, 'utf-8').trim();
 12: }
 13: 
 14: function stripCommentsAndBlankLines(code: string): string {
 15:   return code
 16:     .replace(/\/\*[\s\S]*?\*\//g, '')
 17:     .split(/\r?\n/)
 18:     .map((line) => line.replace(/\s+\/\/.*$/, ''))
 19:     .filter((line) => {
 20:       const t = line.trim();
 21:       return t.length > 0 && !t.startsWith('//');
 22:     })
 23:     .join('\n');
 24: }
 25: 
 26: function extractComponentSkeleton(relPath: string): string {
 27:   const fullPath = path.join(ROOT, relPath);
 28:   const raw = fs.readFileSync(fullPath, 'utf-8');
 29:   const lines = raw.split(/\r?\n/);
 30: 
 31:   // 1. Extract import statements (compact multi-line lucide-react imports to 1 line)
 32:   const imports: string[] = [];
 33:   let inImport = false;
 34:   let currentImport: string[] = [];
 35: 
 36:   for (const line of lines) {
 37:     const trimmed = line.trim();
 38:     const hasFrom = trimmed.includes("from '") || trimmed.includes('from "') || /^import\s+['"]/.test(trimmed);
 39:     if (!inImport && trimmed.startsWith('import ')) {
 40:       if (hasFrom) {
 41:         imports.push(trimmed);
 42:       } else {
 43:         inImport = true;
 44:         currentImport = [trimmed];
 45:       }
 46:     } else if (inImport) {
 47:       currentImport.push(trimmed);
 48:       if (hasFrom || trimmed.endsWith(';')) {
 49:         const joined = currentImport.join(' ');
 50:         if (joined.includes('lucide-react')) {
 51:           imports.push(`import { /* icons */ } from 'lucide-react';`);
 52:         } else {
 53:           imports.push(joined);
 54:         }
 55:         inImport = false;
 56:         currentImport = [];
 57:       }
 58:     }
 59:   }
 60: 
 61:   // 2. Extract top-level TypeScript interface / type declarations (strictly PascalCase identifiers, never JSX attributes)
 62:   const interfaces: string[] = [];
 63:   let inInterface = false;
 64:   let braceDepth = 0;
 65:   let currentInterface: string[] = [];
 66: 
 67:   for (const line of lines) {
 68:     const trimmed = line.trim();
 69:     if (
 70:       !inInterface &&
 71:       /^(export\s+)?(interface|type)\s+[A-Z][A-Za-z0-9_]*(\s*=|\s*\{|\s*<)/.test(trimmed)
 72:     ) {
 73:       if (!trimmed.includes('{')) {
 74:         interfaces.push(trimmed);
 75:       } else {
 76:         inInterface = true;
 77:         braceDepth =
 78:           (trimmed.match(/\{/g) || []).length - (trimmed.match(/\}/g) || []).length;
 79:         currentInterface = [line];
 80:         if (braceDepth <= 0) {
 81:           interfaces.push(currentInterface.join('\n'));
 82:           inInterface = false;
 83:           currentInterface = [];
 84:         }
 85:       }
 86:     } else if (inInterface) {
 87:       currentInterface.push(line);
 88:       braceDepth +=
 89:         (line.match(/\{/g) || []).length - (line.match(/\}/g) || []).length;
 90:       if (braceDepth <= 0 || currentInterface.length >= 25) {
 91:         interfaces.push(currentInterface.join('\n'));
 92:         inInterface = false;
 93:         currentInterface = [];
 94:       }
 95:     }
 96:   }
 97: 
 98:   // 3. Extract state hooks (useState, useLocalStorageState, useFlexibleProtocol)
 99:   const stateLines = lines
100:     .map((l, idx) => ({ line: l.trim(), lineNo: idx + 1 }))
101:     .filter(
102:       ({ line }) =>
103:         (line.startsWith('const [') || line.startsWith('const {')) &&
104:         (line.includes('useState') ||
105:           line.includes('useLocalStorageState') ||
106:           line.includes('useFlexibleProtocol'))
107:     )
108:     .map(({ line, lineNo }) =>
109:       `L${lineNo}: ${line.length > 140 ? line.slice(0, 137) + '...' : line}`
110:     );
111: 
112:   return [
113:     `### \`${relPath}\` (${lines.length} lines)`,
114:     '```ts',
115:     '// --- Imports ---',
116:     ...imports,
117:     '// --- Props & Types ---',
118:     ...(interfaces.length > 0 ? interfaces : ['// (No local interfaces)']),
119:     '// --- State & Protocol Hooks ---',
120:     ...(stateLines.length > 0 ? stateLines : ['// (Stateless component)']),
121:     '```'
122:   ].join('\n');
123: }
124: 
125: function buildUltraDigest(): string {
126:   const componentsDir = path.join(ROOT, 'src/components');
127:   const componentFiles = fs
128:     .readdirSync(componentsDir)
129:     .filter((f) => f.endsWith('.tsx'))
130:     .sort()
131:     .map((f) => `src/components/${f}`);
132: 
133:   const componentSkeletons = [
134:     extractComponentSkeleton('src/context/EnologyUiContext.tsx'),
135:     ...componentFiles.map((rel) => extractComponentSkeleton(rel))
136:   ].join('\n\n');
137: 
138:   return [
139:     '# ENOLOGY STUDIO — AI ULTRA DIGEST (LOW-TOKEN ARCHITECTURE & CONTRACTS)',
140:     `> Generated automatically via \`npm run ai:digest\`. Share this single file with any AI assistant to provide 100% of data contracts, API signatures, and UI component state wiring.`,
141:     '',
142:     '## 1. Architecture & Agent Protocol (`AGENTS.md`)',
143:     readSafe('AGENTS.md'),
144:     '',
145:     '## 2. Project Task State (`.agent/TASK_STATE.md`)',
146:     readSafe('.agent/TASK_STATE.md'),
147:     '',
148:     '## 3. Data Models & Zod Schemas (`src/types/tracking.ts` & `src/types/database.ts`)',
149:     '### `src/types/tracking.ts`',
150:     '```ts',
151:     stripCommentsAndBlankLines(readSafe('src/types/tracking.ts')),
152:     '```',
153:     '### `src/types/database.ts`',
154:     '```ts',
155:     stripCommentsAndBlankLines(readSafe('src/types/database.ts')),
156:     '```',
157:     '',
158:     '## 4. Core Engine API Signatures (`.agent/API_SIGNATURES.md`)',
159:     readSafe('.agent/API_SIGNATURES.md'),
160:     '',
161:     '## 5. UI Component Wiring & State Skeleton (`src/context/EnologyUiContext.tsx` & `src/components/*.tsx` — JSX Omitted)',
162:     componentSkeletons,
163:     ''
164:   ].join('\n');
165: }
166: 
167: function buildCoreLogicBundle(ultraDigest: string): string {
168:   const coreFiles = [
169:     'src/context/EnologyUiContext.tsx',
170:     'src/data/masterProtocolConfig.ts',
171:     'src/utils/enologyUtils.ts',
172:     'src/utils/trackingCalculations.ts',
173:     'src/utils/enologyTroubleshooting.ts',
174:     'src/utils/rightNowEngine.ts',
175:     'src/db/enologyDatabase.ts'
176:   ];
177: 
178:   const sourceSections = coreFiles
179:     .map((relPath) => {
180:       const content = stripCommentsAndBlankLines(readSafe(relPath));
181:       const lineCount = content.split(/\r?\n/).length;
182:       return [
183:         `### \`${relPath}\` (${lineCount} compact lines)`,
184:         '```ts',
185:         content,
186:         '```'
187:       ].join('\n');
188:     })
189:     .join('\n\n');
190: 
191:   return [
192:     ultraDigest,
193:     '---',
194:     '',
195:     '## 6. Complete Scientific & Database Engine Source Code',
196:     sourceSections,
197:     ''
198:   ].join('\n');
199: }
200: 
201: function main() {
202:   const ultraDigest = buildUltraDigest();
203:   const coreBundle = buildCoreLogicBundle(ultraDigest);
204: 
205:   const ultraPath = path.join(ROOT, 'AI_ULTRA_DIGEST.md');
206:   const bundlePath = path.join(ROOT, 'AI_CORE_LOGIC_BUNDLE.md');
207: 
208:   fs.writeFileSync(ultraPath, ultraDigest, 'utf-8');
209:   fs.writeFileSync(bundlePath, coreBundle, 'utf-8');
210: 
211:   const ultraTokens = Math.round(ultraDigest.length / 4);
212:   const bundleTokens = Math.round(coreBundle.length / 4);
213: 
214:   console.log(
215:     `[ai:digest] Generated AI_ULTRA_DIGEST.md (${ultraDigest.length.toLocaleString()} chars / ~${ultraTokens.toLocaleString()} tokens)`
216:   );
217:   console.log(
218:     `[ai:digest] Generated AI_CORE_LOGIC_BUNDLE.md (${coreBundle.length.toLocaleString()} chars / ~${bundleTokens.toLocaleString()} tokens)`
219:   );
220: }
221: 
222: main();
</file>

