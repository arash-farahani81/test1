  45: export function brixToSpecificGravity(brix: number): number {
  46:   if (brix <= 0) return 1.000;
  47:   const sg = 1 + brix / (258.6 - brix * 0.88);
  48:   return Math.round(sg * 1000) / 1000;
  49: }
  50: 
  51: export function specificGravityToBrix(sg: number): number {
  52:   if (sg <= 1.000) return 0;
  53:   const brix = 261.3 * (1 - 1 / sg);
  54:   return Math.max(0, Math.round(brix * 10) / 10);
  55: }
