 405:           'افزایش غیرمنتظرهٔ SG نسبت به ثبت قبلی؛ احتمال خطای قرائت، چسبیدن حباب گاز CO2 به هیدرومتر، عدم تصحیح دمای نمونه یا رکود تخمیر را بررسی کنید.'
 406:       };
 407:     }
 408:   }
 409: 
 410:   const dynTriggers = calculateDynamicSGTriggers(plan.triggers.initialSG, {
 411:     pressingPoint: plan.triggers.pressingSG,
 412:     drynessPoint: activeTankId === 'tank-rose' ? 0.991 : plan.triggers.drynessSG
