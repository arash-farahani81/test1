 566: export function compareRealLogsWithBenchmark(
 567:   realLogs: FermentationLogEntry[],
 568:   benchmarkLogs: FermentationLogEntry[],
 569:   tankId: TankId = 'tank-a'
 570: ): BenchmarkComparison {
 571:   const isRose = tankId === 'tank-rose';
 572:   if (!realLogs || realLogs.length === 0) {
 573:     return {
 574:       hasRealLogs: false,
 575:       alignmentScore: 0,
 576:       sugarDepletionPct: 0,
 577:       statusTitle: 'آماده‌باش ثبت داده‌های واقعی - الگوی مرجع ایده‌آل فعال است',
 578:       statusBadge: 'منحنی الگوی مرجع ایده‌آل',
 579:       statusColor: 'indigo',
 580:       sgDelta: 0,
 581:       tempDelta: 0,
 582:       phDelta: 0,
 583:       brixDelta: 0,
 584:       comparisonDetails:
 585:         'در حال حاضر هیچ داده واقعی توسط شما ثبت نشده است. نمودارها و شاخص‌ها، «الگوی مرجع ایده‌آل تخمیر و استخراج رشه» را نمایش می‌دهند. به محض اینکه اعداد و اندازه‌گیری‌های واقعی کارگاه خود را ثبت کنید، نمودار واقعی به صورت خط ممتد بر روی منحنی مرجع نقطه چین نگاشت خواهد شد تا مقایسه لحظه‌ای داشته باشید.',
 586:       actionableGuidance:
 587:         'جهت شروع ثبت، روی دکمه «ثبت داده واقعی» کلیک کنید یا فرم‌های روزانه نقشه راه را تکمیل کنید.'
 588:     };
 589:   }
 590: 
 591:   const sortedReal = sortFermentationLogs(realLogs);
 592:   const latestReal = sortedReal[sortedReal.length - 1];
 593:   const sugarDepletionPct = calculateFermentationProgress(
 594:     latestReal.sg,
 595:     MASTER_PROTOCOL_CONFIG.metadata.targetInitialSG,
 596:     isRose ? MASTER_PROTOCOL_CONFIG.metadata.roseFinalSG : MASTER_PROTOCOL_CONFIG.metadata.redFinalSG
 597:   );
 598: 
 599:   let stageMatchedBench: FermentationLogEntry | undefined;
 600:   let dayMatchedBench: FermentationLogEntry | undefined;
 601:   if (benchmarkLogs.length > 0) {
 602:     stageMatchedBench = benchmarkLogs.reduce((prev, curr) =>
 603:       Math.abs(curr.sg - latestReal.sg) < Math.abs(prev.sg - latestReal.sg) ? curr : prev
 604:     );
 605:     dayMatchedBench =
 606:       benchmarkLogs.find((bm) => bm.dayNumber === latestReal.dayNumber) ??
 607:       benchmarkLogs.reduce((prev, curr) =>
 608:         Math.abs(curr.dayNumber - latestReal.dayNumber) <
 609:         Math.abs(prev.dayNumber - latestReal.dayNumber)
 610:           ? curr
 611:           : prev
 612:       );
 613:   }
 614: 
 615:   const dayBenchSG = dayMatchedBench
 616:     ? dayMatchedBench.sg
 617:     : stageMatchedBench
 618:     ? stageMatchedBench.sg
 619:     : 1.092;
 620:   const dayBenchBrix = dayMatchedBench
 621:     ? dayMatchedBench.brix
 622:     : stageMatchedBench
 623:     ? stageMatchedBench.brix
 624:     : 22.0;
 625:   const benchTemp = stageMatchedBench ? stageMatchedBench.tempCap : 22.0;
 626:   const benchPH = stageMatchedBench ? stageMatchedBench.ph : 3.52;
 627: 
 628:   const sgDelta = Math.round((latestReal.sg - dayBenchSG) * 1000) / 1000;
 629:   const tempDelta = Math.round((latestReal.tempCap - benchTemp) * 10) / 10;
 630:   const phDelta = Math.round((latestReal.ph - benchPH) * 100) / 100;
 631:   const brixDelta = Math.round((latestReal.brix - dayBenchBrix) * 10) / 10;
 632: 
 633:   let totalDevScore = 0;
 634:   let maxDatasetError = 0;
 635:   sortedReal.forEach((r) => {
 636:     let b = benchmarkLogs.find((bm) => bm.dayNumber === r.dayNumber);
 637:     if (!b && benchmarkLogs.length > 0) {
 638:       b = benchmarkLogs.reduce((prev, curr) =>
 639:         Math.abs(curr.dayNumber - r.dayNumber) < Math.abs(prev.dayNumber - r.dayNumber) ? curr : prev
 640:       );
 641:     }
 642:     const bSG = b ? b.sg : 1.092;
 643:     const bT = b ? b.tempCap : 22.0;
 644: 
 645:     // Tightened normalization: 0.025 SG deviation = 1.0 error unit; 3.0°C temp deviation = 1.0 error unit
 646:     const sgErr = Math.abs(r.sg - bSG) / 0.025;
 647:     const tErr = Math.abs(r.tempCap - bT) / 3.0;
 648:     const pointMax = Math.max(sgErr, tErr);
 649:     if (pointMax > maxDatasetError) {
 650:       maxDatasetError = pointMax;
 651:     }
 652:     const pointError = (sgErr + tErr) / 2;
 653:     totalDevScore += pointError;
 654:   });
 655: 
 656:   const avgDev = totalDevScore / sortedReal.length;
 657:   // Blend average deviation with dataset-wide maximum deviation so a single-day catastrophic spike immediately lowers alignmentScore
 658:   const effectiveDev = 0.5 * avgDev + 0.5 * maxDatasetError;
 659:   const alignmentScore = Math.max(0, Math.min(100, Math.round((1 - effectiveDev * 0.5) * 100)));
 660: 
 661:   let statusTitle = `انطباق بسیار بالا با منحنی مرجع ایده‌آل (${alignmentScore}٪)`;
 662:   let statusBadge = 'تطبیق عالی با الگو';
 663:   let statusColor: 'emerald' | 'amber' | 'rose' | 'indigo' = 'emerald';
 664: 
 665:   if (alignmentScore < 75) {
 666:     statusTitle = `انحراف قابل توجه از الگوی مرجع (${alignmentScore}٪ انطباق)`;
 667:     statusBadge = 'نیازمند اصلاح شرایط';
 668:     statusColor = 'rose';
 669:   } else if (alignmentScore < 90) {
 670:     statusTitle = `انحراف جزئی از منحنی مرجع (${alignmentScore}٪ انطباق)`;
 671:     statusBadge = 'کنترل خنک‌سازی / سرعت';
 672:     statusColor = 'amber';
 673:   }
 674: 
 675:   let comparisonDetails = `در روز ${latestReal.dayNumber} تخمیر، وزن مخصوص شما ${latestReal.sg} (اختلاف ${sgDelta > 0 ? '+' : ''}${sgDelta} نسبت به الگو) و دمای کلاهک ${latestReal.tempCap}°C (اختلاف ${tempDelta > 0 ? '+' : ''}${tempDelta}°C) است. `;
 676: 
 677:   if (Math.abs(sgDelta) <= 0.003 && Math.abs(tempDelta) <= 1.0) {
 678:     comparisonDetails += 'پروفایل تخمیر کارگاه شما کاملاً بر روی منحنی مرجع ایده‌آل استخراج و تخمیر رشه منطبق است.';
 679:   } else if (sgDelta < -0.003) {
 680:     comparisonDetails += 'سرعت افت قند و تخمیر شما نسبت به منحنی مرجع ایده‌آل سریع‌تر است (کاهش زودتر SG).';
 681:   } else if (sgDelta > 0.003) {
 682:     comparisonDetails += 'سرعت افت قند نسبت به الگو کمی کُندتر است (احتمال دمای پایین‌تر یا کمبود اولیه YAN).';
 683:   }
 684: 
 685:   let actionableGuidance = '';
 686:   if (tempDelta > 1.5) {
 687:     actionableGuidance = `دمای کلاهک شما ${tempDelta}°C از منحنی مرجع بالاتر است. برای جابجایی منحنی واقعی به سمت الگوی ایده‌آل، از بطری‌های یخ زیر کلاهک استفاده کرده و تعداد نوبت‌های غوطه‌ورسازی (Pigeage) را افزایش دهید.`;
 688:   } else if (sgDelta < -0.005) {
 689:     actionableGuidance = 'تخمیر با سرعت بالاتر از الگو پیش می‌رود. جهت جلوگیری از جهش دمایی ناگهانی، سیستم خنک‌سازی کارگاه را یک درجه فعال‌تر کنید.';
 690:   } else if (sgDelta > 0.005) {
 691:     actionableGuidance = 'برای شتاب‌بخشی مطبق بر الگو، دمای محیط کارگاه را بین ۲۰ تا ۲۲ درجه تنظیم کرده و هوادهی سبک انجام دهید.';
 692:   } else {
 693:     actionableGuidance = 'روند کارگاه عالی است! طبق برنامه زمان‌بندی الگوی مرجع، نوبت بعدی پایش و تزریق را ادامه دهید.';
 694:   }
 695: 
 696:   return {
 697:     hasRealLogs: true,
 698:     alignmentScore,
 699:     sugarDepletionPct,
 700:     statusTitle,
 701:     statusBadge,
 702:     statusColor,
 703:     sgDelta,
 704:     tempDelta,
 705:     phDelta,
 706:     brixDelta,
 707:     latestRealLog: latestReal,
 708:     matchedBenchmarkLog: dayMatchedBench ?? stageMatchedBench,
 709:     comparisonDetails,
 710:     actionableGuidance
 711:   };
 712: }
