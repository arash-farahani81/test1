 960:   }
 961: 
 962:   // ----------------------------------------------------
 963:   // OVERALL HEALTH EVALUATION & PROGRESSIVE DISCLOSURE
 964:   // ----------------------------------------------------
 965:   const enrichedActions: CorrectiveAction[] = actions.map((action) => {
 966:     const alertTier: 'critical' | 'attention' | 'info' =
 967:       action.alertTier === 'info' || action.severity === 'normal'
 968:         ? 'info'
 969:         : action.severity === 'danger'
 970:         ? 'critical'
 971:         : 'attention';
 972:     const canSnooze = alertTier !== 'critical';
 973: 
 974:     let confidenceBadge = action.confidenceBadge;
 975:     let confidenceLabelFa = action.confidenceLabelFa;
 976:     if (!confidenceBadge) {
 977:       if (
 978:         action.solutionSummary.includes('تخمین تجربی') ||
 979:         action.category === 'Tannin_Fining'
 980:       ) {
 981:         confidenceBadge = 'rule_of_thumb';
 982:         confidenceLabelFa = 'قاعدهٔ سرانگشتی تجربی';
 983:       } else {
 984:         confidenceBadge = 'stoichiometric';
 985:         confidenceLabelFa = 'محاسبهٔ استوکیومتری قطعی';
 986:       }
 987:     }
 988: 
 989:     const sanitizedRecipes =
 990:       hasInvalidVolume && action.calculatedRecipe
 991:         ? action.calculatedRecipe.map((r) => ({
 992:             ...r,
 993:             amount: '0',
 994:             instruction: 'محاسبه متوقف شد — ابتدا حجم معتبر مخزن را وارد کنید'
 995:           }))
 996:         : action.calculatedRecipe;
 997: 
 998:     const firstRecipe = sanitizedRecipes?.[0];
 999:     const layer1ActionFa = firstRecipe
1000:       ? `${firstRecipe.amount} ${firstRecipe.unit} ${firstRecipe.item} (${action.solutionSummary})`
1001:       : action.solutionSummary;
1002: 
1003:     return {
1004:       ...action,
1005:       calculatedRecipe: sanitizedRecipes,
1006:       alertTier,
1007:       canSnooze,
1008:       confidenceBadge,
1009:       confidenceLabelFa,
1010:       progressiveLayers: {
1011:         layer1ActionFa,
1012:         layer2WhyFa: action.diagnosis,
1013:         layer3ScienceFa: action.steps.join(' | ')
1014:       }
1015:     };
1016:   });
1017: 
1018:   const infoActions = enrichedActions.filter((a) => a.alertTier === 'info');
1019:   const severityRank: Record<CorrectiveAction['severity'], number> = {
1020:     danger: 0,
1021:     warning: 1,
1022:     caution: 2,
1023:     normal: 3
1024:   };
1025:   const sortedNonInfo = enrichedActions
1026:     .filter((a) => a.alertTier !== 'info')
1027:     .sort((a, b) => severityRank[a.severity] - severityRank[b.severity]);
1028: 
1029:   const criticalNonInfoCount = sortedNonInfo.filter((a) => a.severity === 'danger').length;
1030:   const visibleLimit = Math.max(3, criticalNonInfoCount);
1031:   const visibleActions = sortedNonInfo.slice(0, visibleLimit);
1032:   const hiddenActionsCount = Math.max(0, sortedNonInfo.length - visibleLimit);
1033: 
1034:   const finalScore = Math.max(0, Math.min(100, score));
1035:   const criticalWarningsCount = enrichedActions.filter((a) => a.severity === 'danger').length;
1036: 
1037:   let overallStatusText = 'تمام پارامترها و شرایط کارگاهی در محدوده ایده‌آل و ایمن قرار دارند.';
1038:   let overallStatusColor: 'emerald' | 'amber' | 'rose' | 'blue' = 'emerald';
1039: 
1040:   if (criticalWarningsCount > 0) {
1041:     overallStatusText = `توجه: ${criticalWarningsCount} خطای بحرانی کشف شد! نیازمند اقدام و مداخله فوری کارگاهی.`;
1042:     overallStatusColor = 'rose';
1043:   } else if (sortedNonInfo.length > 0) {
1044:     overallStatusText = `شرایط نسبتاً مطلوب است؛ ${sortedNonInfo.length} دستورالعمل اصلاحی جهت بهینه‌سازی پیشنهاد گردید.`;
1045:     overallStatusColor = 'amber';
1046:   }
1047: 
1048:   return {
1049:     overallHealthScore: finalScore,
1050:     overallStatusText,
1051:     overallStatusColor,
1052:     criticalWarningsCount,
1053:     actions: enrichedActions,
1054:     visibleActions,
1055:     hiddenActionsCount,
1056:     infoActions,
1057:     hasInvalidVolume
1058:   };
1059: }
