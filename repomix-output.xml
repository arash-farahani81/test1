371: function readStorageString<T extends string>(key: string, fallback: T): T {
372:   if (typeof window === 'undefined' || typeof localStorage === 'undefined') {
373:     return fallback;
374:   }
375:   try {
376:     const raw = localStorage.getItem(key);
377:     return raw ? (raw as T) : fallback;
378:   } catch {
379:     return fallback;
380:   }
381: }
382: 
383: function writeStorageString(key: string, value: string): void {
384:   if (typeof window === 'undefined' || typeof localStorage === 'undefined') {
385:     return;
386:   }
387:   try {
388:     localStorage.setItem(key, value);
389:   } catch {
390:     window.dispatchEvent(
391:       new CustomEvent('enology-storage-error', {
392:         detail: 'ذخیره تنظیمات UI ناموفق بود؛ حافظه مرورگر پر یا مسدود است.'
393:       })
394:     );
395:   }
396: }
