1243:     status: 'green' | 'amber' | 'red';
1244:     daysSinceBackup: number | null;
1245:     unsavedChangesCount: number;
1246:     labelFa: string;
1247:   } {
1248:     const daysSinceBackup =
1249:       this.lastBackupMs !== null
1250:         ? Math.floor((Date.now() - this.lastBackupMs) / (1000 * 60 * 60 * 24))
1251:         : null;
1252:     const unsavedChangesCount = this.changesSinceBackup;
1253: 
1254:     if (daysSinceBackup === null || daysSinceBackup >= 7) {
1255:       return {
1256:         status: 'red',
1257:         daysSinceBackup,
1258:         unsavedChangesCount,
1259:         labelFa: 'پشتیبانگیری نشده یا بیش از ۷ روز گذشته'
1260:       };
1261:     }
1262: 
1263:     if (daysSinceBackup >= 3 || unsavedChangesCount > 10) {
1264:       return {
1265:         status: 'amber',
1266:         daysSinceBackup,
1267:         unsavedChangesCount,
1268:         labelFa: 'نیازمند پشتیبانگیری جدید'
1269:       };
1270:     }
1271: 
1272:     return {
1273:       status: 'green',
1274:       daysSinceBackup,
