344: /**
345:  * Free SO2 Ripper Titration test
346:  * Formula: Free SO2 (mg/L or ppm) = (V_I2 (mL) * N_I2 * 32 * 1000) / V_sample (mL)
347:  * (32 is the equivalent weight of SO2)
348:  */
349: export function calculateFreeSO2Ripper(
350:   vI2_mL: number,
351:   nI2: number = 0.02,
352:   vSample_mL: number = 25
353: ): number {
354:   if (vSample_mL <= 0 || vI2_mL <= 0) return 0;
355:   const freeSO2 = (vI2_mL * nI2 * 32 * 1000) / vSample_mL;
356:   return Math.round(freeSO2 * 10) / 10;
357: }
358: 
359: /**
360:  * Molecular (active antimicrobial) SO2 from Free SO2 and pH
361:  * Formula: Molecular SO2 = Free SO2 / (1 + 10^(pH - 1.81))
362:  * Standard target: 0.8 mg/L for red wines (or 0.5-0.8), preventing Brettanomyces & spoilage
363:  */
364: export function calculateMolecularSO2(freeSO2_ppm: number, pH: number): number {
365:   if (freeSO2_ppm <= 0 || pH <= 0) return 0;
366:   const denominator = 1 + Math.pow(10, pH - 1.81);
367:   const molecular = freeSO2_ppm / denominator;
368:   return Math.round(molecular * 100) / 100;
369: }
