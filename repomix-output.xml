1231: export type FlexibleProtocolSyncListener = (params: FlexibleProtocolParams) => void;
1232: const flexibleProtocolSyncListeners = new Set<FlexibleProtocolSyncListener>();
1233: 
1234: export function onFlexibleProtocolSync(listener: FlexibleProtocolSyncListener): () => void {
1235:   flexibleProtocolSyncListeners.add(listener);
1236:   return () => {
1237:     flexibleProtocolSyncListeners.delete(listener);
1238:   };
1239: }
1240: 
1241: export function notifyFlexibleProtocolSync(next: FlexibleProtocolParams): void {
1242:   if (typeof localStorage !== 'undefined') {
1243:     try {
1244:       localStorage.setItem(FLEXIBLE_PROTOCOL_STORAGE_KEY, JSON.stringify(next));
1245:     } catch (err) {
1246:       console.warn('Error saving flexible protocol params:', err);
1247:     }
1248:   }
1249:   for (const listener of flexibleProtocolSyncListeners) {
1250:     try {
1251:       listener(next);
1252:     } catch (err) {
1253:       console.warn('Error in flexible protocol sync listener:', err);
1254:     }
1255:   }
1256:   if (typeof window !== 'undefined' && typeof window.dispatchEvent === 'function') {
1257:     try {
1258:       window.dispatchEvent(new CustomEvent(FLEXIBLE_PROTOCOL_SYNC_EVENT, { detail: next }));
1259:     } catch (err) {
1260:       console.warn('Error dispatching flexible protocol sync event:', err);
1261:     }
1262:   }
1263: }
