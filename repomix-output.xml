 631:   public updateBatch(id: string, updates: Partial<WineBatch>): WineBatch | null {
 632:     const idx = this.batches.findIndex((b) => b.id === id);
 633:     if (idx === -1) return null;
 634:     this.hasLocalMutations = true;
 635:     this.batches[idx] = { ...this.batches[idx], ...updates, updatedAtMs: Date.now() };
 636:     this.persistBatches();
 637:     this.incrementChangesSinceBackup();
 638:     return this.batches[idx];
 639:   }
