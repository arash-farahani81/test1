 843: /**
 844:  * Predictive Engine for Estimating Remaining Fermentation Days
 845:  * Analyzes SG drop velocity, temperature Arrhenius kinetics, and sugar depletion curves
 846:  * without double-counting temperature/depletion slowdowns on observed velocity.
 847:  */
 848: export function predictFermentationCompletion(
 849:   logs: FermentationLogEntry[],
 850:   tankId: TankId = 'tank-a',
 851:   targetSGOverride?: number,
 852:   tempOverride?: number,
 853:   initialSGOverride?: number,
 854:   planOverride?: DynamicProtocolPlan
 855: ): FermentationPredictionResult {
 856:   const isRose = tankId === 'tank-rose';
 857:   const planTriggers = (planOverride ?? getCurrentDynamicProtocolPlan()).triggers;
 858:   const defaultTargetSG = isRose ? 0.991 : planTriggers.drynessSG;
 859:   const targetSG = targetSGOverride ?? defaultTargetSG;
 860:   const fallbackInitialSG = initialSGOverride ?? planTriggers.initialSG;
 861: 
 862:   const filteredLogs = sortFermentationLogs(logs.filter((l) => l.tankId === tankId));
 863: 
 864:   // Fallback default if no logs exist
 865:   if (filteredLogs.length === 0) {
 866:     const currentSG = fallbackInitialSG;
 867:     const sgRemaining = Math.max(0, currentSG - targetSG);
 868:     const estDays = Math.round((sgRemaining / 0.0125) * 10) / 10;
 869:     return {
 870:       currentSG,
 871:       targetSG,
 872:       sgRemaining,
 873:       recentVelocityPerDay: 0.0125,
 874:       tempKineticFactor: 1.0,
 875:       effectiveVelocityPerDay: 0.0125,
 876:       estimatedRemainingDays: estDays,
 877:       estimatedRemainingHours: Math.round(estDays * 24),
 878:       estimatedDaysRange: {
 879:         min: Math.max(0, Math.round(estDays * 0.8 * 10) / 10),
 880:         max: Math.round(estDays * 1.25 * 10) / 10
 881:       },
 882:       stageName: isRose ? 'خشکی کامل رُزه (SG = 0.991)' : 'خشکی کامل قرمز (SG = 0.993)',
 883:       kineticStatus: 'normal',
 884:       kineticStatusFa: 'در حال شروع تخمیر (حالت استاندارد)',
 885:       kineticAdviceFa: 'تخمیر تازه آغاز شده است؛ پس از ثبت لاگ‌های روزانه ۲ و ۳، دقت پیش‌بینی هوشمند افزایش می‌یابد.',
 886:       tempImpactDescription: 'دمای نرمال کارگاه (۲۲°C) - سرعت استخراج استاندارد.',
 887:       isOutOfModelBounds: false
 888:     };
 889:   }
 890: 
 891:   const latestLog = filteredLogs[filteredLogs.length - 1];
 892:   const currentSG = latestLog.sg;
 893:   const sgRemaining = Math.max(0, Math.round((currentSG - targetSG) * 1000) / 1000);
 894: 
 895:   // If already at or below target SG
 896:   if (sgRemaining <= 0) {
 897:     return {
 898:       currentSG,
 899:       targetSG,
 900:       sgRemaining: 0,
 901:       recentVelocityPerDay: 0,
 902:       tempKineticFactor: 1.0,
 903:       effectiveVelocityPerDay: 0,
 904:       estimatedRemainingDays: 0,
 905:       estimatedRemainingHours: 0,
 906:       estimatedDaysRange: { min: 0, max: 0 },
 907:       stageName: 'مرحله فعلی تخمیر کاملاً به پایان رسیده است',
 908:       kineticStatus: 'finished',
 909:       kineticStatusFa: 'پایان تخمیر (خشکی کامل)',
 910:       kineticAdviceFa: 'قند به پایان رسیده و شراب به خشکی مطلق رسیده است. آمادگی برای سیفون، خنک‌سازی و سولفیت‌زنی.',
 911:       tempImpactDescription: 'تخمیر متوقف شده (قند مصرف شده است).',
 912:       isOutOfModelBounds: false
 913:     };
 914:   }
 915: 
 916:   // 1. Calculate recent SG drop velocity per day (protected against same-day division by zero)
 917:   const { recentVelocityPerDay, hasObservedVelocity, referenceSG } = calculateRecentLogVelocity(
 918:     filteredLogs,
 919:     fallbackInitialSG
 920:   );
 921: 
 922:   // 2. Substrate depletion factor (Michaelis-Menten kinetics)
 923:   const depletionFactor = getSubstrateDepletionFactor(currentSG);
 924: 
 925:   // 3. Non-Linear Cardinal Temperature Kinetic Factor
 926:   const effectiveTemp = tempOverride ?? latestLog.tempCap;
 927:   const refTemp = isRose ? 17.0 : 22.0;
 928:   const tempDiff = effectiveTemp - refTemp;
 929: 
 930:   let tempKineticFactor = 1.0;
 931:   if (!isRose) {
 932:     if (effectiveTemp < 16.0) {
 933:       const coldPenalty = Math.max(0.50, 1.0 - (16.0 - effectiveTemp) * 0.08);
 934:       tempKineticFactor = Math.max(
 935:         0.15,
 936:         Math.pow(1.8, (effectiveTemp - 22.0) / 10) * coldPenalty
 937:       );
 938:     } else if (effectiveTemp <= 28.0) {
 939:       tempKineticFactor = Math.pow(1.8, (effectiveTemp - 22.0) / 10);
 940:     } else if (effectiveTemp <= 29.5) {
 941:       tempKineticFactor = 1.42 - ((effectiveTemp - 28.0) / 1.5) * 0.42;
 942:     } else if (effectiveTemp <= 32.0) {
 943:       tempKineticFactor = 1.00 - ((effectiveTemp - 29.5) / 2.5) * 0.65;
 944:     } else {
 945:       tempKineticFactor = 0.15;
 946:     }
 947:   } else {
 948:     if (effectiveTemp < 13.0) {
 949:       tempKineticFactor = 0.25;
 950:     } else if (effectiveTemp <= 19.0) {
 951:       tempKineticFactor = Math.pow(1.8, (effectiveTemp - 17.0) / 10);
 952:     } else if (effectiveTemp <= 24.0) {
 953:       const peakRose = Math.pow(1.8, (19.0 - 17.0) / 10);
 954:       tempKineticFactor = peakRose - ((effectiveTemp - 19.0) / 5.0) * (peakRose - 0.85);
 955:     } else {
 956:       tempKineticFactor = 0.35;
 957:     }
 958:   }
 959: 
 960:   tempKineticFactor = Math.round(tempKineticFactor * 100) / 100;
 961:   const isOutOfModelBounds = effectiveTemp < 13.0 || effectiveTemp >= 30.5;
 962: 
 963:   // 4. Theoretical baseline velocity strictly receives absolute F_depletion and K_temp
 964:   const velBaseline = 0.0125 * depletionFactor * tempKineticFactor;
 965: 
 966:   // 5. Avoid double-counting on observed velocity:
 967:   // Only apply a relative depletion factor if currentSG just crossed into a lower threshold zone (< 1.030 or < 1.005)
 968:   // compared to the reference reading, then blend 70% observed velocity + 30% theoretical baseline velocity.
 969:   const prevDepletionFactor = getSubstrateDepletionFactor(referenceSG);
 970:   const relativeDepletion =
 971:     depletionFactor < prevDepletionFactor ? depletionFactor / prevDepletionFactor : 1.0;
 972: 
 973:   const effectiveVelocityPerDay = hasObservedVelocity
 974:     ? Math.max(0.001, 0.7 * (recentVelocityPerDay * relativeDepletion) + 0.3 * velBaseline)
 975:     : Math.max(0.001, velBaseline);
 976: 
 977:   // Estimated remaining days
 978:   const rawEstDays = sgRemaining / effectiveVelocityPerDay;
 979:   const estimatedRemainingDays = Math.round(rawEstDays * 10) / 10;
 980:   const estimatedRemainingHours = Math.round(estimatedRemainingDays * 24);
 981: 
 982:   // Kinetic status classification with Lag Phase & Noise Guard
 983:   const initialSG = filteredLogs[0]?.sg ?? fallbackInitialSG;
 984:   const isLagPhase =
 985:     latestLog.dayNumber <= 1 ||
 986:     (latestLog.dayNumber <= 2 && initialSG - currentSG <= 0.006);
 987:   const canReportStuck =
 988:     !isLagPhase && (latestLog.dayNumber >= 2 || filteredLogs.length >= 3);
 989: 
 990:   let kineticStatus: 'fast' | 'normal' | 'sluggish' | 'stuck' | 'finished' = 'normal';
 991:   let kineticStatusFa = 'سرعت تخمیر نرمال و ایده‌آل';
 992:   let kineticAdviceFa = 'روند مصرف قند توسط مخمر کاملاً متوازن است. پایش روزانه و تهویه منظم را ادامه دهید.';
 993: 
 994:   if (isLagPhase && recentVelocityPerDay < 0.005) {
 995:     kineticStatus = 'normal';
 996:     kineticStatusFa = 'فاز لَگ و تکثیر اولیه مخمر (طبیعی ۲۴ تا ۴۸ ساعت اول)';
 997:     kineticAdviceFa = 'مخمرها در حال جذب اکسیژن و استرولهای غشایی برای تکثیر سلولی هستند؛ افت کند چگالی در ۴۸ ساعت نخست کاملاً طبیعی است.';
 998:   } else if (canReportStuck && recentVelocityPerDay < 0.003 && currentSG > 1.010) {
 999:     kineticStatus = 'stuck';
1000:     kineticStatusFa = 'توقف یا رکود شدید تخمیر (Stuck Risk)';
1001:     kineticAdviceFa = 'افت قند در ۲۴ ساعت گذشته بسیار ناچیز بوده است! دما را بررسی کرده و هوادهی یا افزودن مکمل/مخمر EC-1118 را اجرا کنید.';
1002:   } else if (!isLagPhase && recentVelocityPerDay < 0.007 && currentSG > 1.005) {
1003:     kineticStatus = 'sluggish';
1004:     kineticStatusFa = 'تخمیر کُند (Sluggish Fermentation)';
1005:     kineticAdviceFa = 'سرعت مصرف قند کمتر از الگوی مرجع است. تنظیم دمای محیط کارگاه بین ۲۱-۲۴ درجه سانتی‌گراد توصیه می‌شود.';
1006:   } else if (recentVelocityPerDay > 0.020) {
1007:     kineticStatus = 'fast';
1008:     kineticStatusFa = 'تخمیر بسیار سریع و پرقدرت (Fast Fermentation)';
1009:     kineticAdviceFa = 'سرعت مصرف قند بالاست؛ دمای مرکز کلاهک را کنترل کنید تا از داغ شدن ناگهانی مخزن جلوگیری شود.';
1010:   }
1011: 
1012:   // Temperature impact description
1013:   let tempImpactDescription = `دمای فعلی کلاهک (${effectiveTemp}°C): `;
1014:   if (isOutOfModelBounds) {
1015:     tempImpactDescription =
1016:       'هشدار: دمای فعلی خارج از دامنه اعتبار سینتیکی مخمر است و خطر توقف حرارتی/برودتی تخمیر وجود دارد!';
1017:   } else if (tempDiff > 2) {
1018:     tempImpactDescription += `افزایش دما سرعت واکنش بیوشیمیایی پایه را ${tempKineticFactor} برابر شتاب داده است.`;
