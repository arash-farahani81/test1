363: const STORAGE_KEY_ACTIVE_BATCH_ID = 'enology_global_active_batch_id';
364: const STORAGE_KEY_UI_ACTIVE_BATCH = 'enology_ui_active_batch_v1';
365: const STORAGE_KEY_SELECTED_TANK = 'enology_global_selected_tank';
366: const STORAGE_KEY_ACTIVE_FIVE_TAB = 'enology_global_active_five_tab';
367: const STORAGE_KEY_FONT_SCALE = 'enology_global_font_scale';
