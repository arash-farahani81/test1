1047:   // --- Cumulative SO2 Budget Ledger ---
1048:   public getCumulativeSO2Ledger(
1049:     tankId: TankId,
1050:     batchVolumeL?: number,
1051:     residualSugarGL: number = 1.5,
1052:     measuredTotalSO2MgL?: number,
1053:     excludeDemo: boolean = false,
1054:     batchId?: string
1055:   ): CumulativeSO2Ledger {
1056:     const defaultVol =
1057:       tankId === 'tank-rose'
1058:         ? MASTER_PROTOCOL_CONFIG.volumes.roseClarifiedFermentL
1059:         : MASTER_PROTOCOL_CONFIG.volumes.redLiquidFermentPerTankL;
1060:     const effectiveVol = batchVolumeL && batchVolumeL > 0 ? batchVolumeL : defaultVol;
1061: 
1062:     const targetBatchId =
1063:       batchId ??
1064:       (excludeDemo
1065:         ? this.batches.find(
1066:             (b) =>
1067:               (tankId === 'tank-rose' ? b.targetStyle === 'rose' : b.targetStyle !== 'rose') &&
1068:               !b.isDemo
1069:           )?.id
1070:         : (
1071:             this.batches.find(
1072:               (b) =>
1073:                 (tankId === 'tank-rose' ? b.targetStyle === 'rose' : b.targetStyle !== 'rose') &&
1074:                 !b.isDemo
1075:             ) ??
1076:             this.batches.find((b) =>
1077:               tankId === 'tank-rose' ? b.targetStyle === 'rose' : b.targetStyle !== 'rose'
1078:             )
1079:           )?.id);
1080: 
1081:     const effectiveQueryBatchId = targetBatchId ?? (excludeDemo ? '__NONE__' : undefined);
1082: 
1083:     const tankAdditions = this.getAdditions(tankId, false, effectiveQueryBatchId).filter((add) => {
1084:       if (add.isDeleted === true) return false;
1085:       if (excludeDemo && add.isDemo === true) return false;
1086:       return true;
1087:     });
1088: 
1089:     const kmsMgPerGram = Math.round(MASTER_PROTOCOL_CONFIG.stoichiometry.kmsActiveSO2Fraction * 1000);
1090:     const kmsMgPerGhL = Math.round((kmsMgPerGram / 100) * 100) / 100;
1091:     const kmsMgPerMl10Pct = Math.round((kmsMgPerGram / 10) * 10) / 10;
1092: 
1093:     let addedFromKmsMgL = 0;
1094:     let totalKmsMassGrams = 0;
1095:     let skippedInvalidUnitCount = 0;
1096:     const stageBreakdown: CumulativeSO2Ledger['stageBreakdown'] = [];
1097: 
1098:     for (const add of tankAdditions) {
1099:       let isKms = false;
1100:       if (add.compoundType !== undefined) {
1101:         isKms = add.compoundType === 'kms';
1102:       } else {
1103:         const isPureBactiless =
1104:           /bactiless|بکتی‌لس|بکتیلس/i.test(add.compoundName) &&
1105:           !/kms|k2s2o5|متابی‌سولفیت|متابیسولفیت/i.test(add.compoundName);
1106:         isKms =
1107:           !isPureBactiless &&
1108:           (add.pubchemCid === 24446 ||
1109:             add.compoundName.includes('سولفیت') ||
1110:             add.compoundName.includes('KMS') ||
1111:             add.compoundName.includes('K2S2O5'));
1112:       }
1113: 
1114:       if (!isKms) continue;
1115: 
1116:       const volForStage =
1117:         add.referenceVolumeL !== undefined && add.referenceVolumeL > 0
1118:           ? add.referenceVolumeL
1119:           : add.stageTitle.includes('150') ||
1120:             add.stageTitle.includes('۱۵۰') ||
1121:             add.purpose.includes('150') ||
1122:             add.purpose.includes('۱۵۰')
1123:           ? MASTER_PROTOCOL_CONFIG.volumes.initialLiquidPerTankL
1124:           : effectiveVol;
1125: 
1126:       if (add.unit === 'mg/L') {
1127:         const contributedMgL = Math.round(add.amount * 10) / 10;
1128:         const rawGrams = (add.amount * volForStage) / kmsMgPerGram;
1129:         const equivalentGrams = Math.round(rawGrams * 100) / 100;
1130:         addedFromKmsMgL += add.amount;
1131:         totalKmsMassGrams += rawGrams;
1132:         stageBreakdown.push({
1133:           id: add.id,
1134:           stageTitle: add.stageTitle,
1135:           amountGrams: equivalentGrams,
1136:           referenceVolumeL: volForStage,
1137:           contributedMgL,
1138:           formulaText: `${add.amount} mg/L (${volForStage} L) = ${contributedMgL} mg/L`,
1139:           isDemo: add.isDemo
1140:         });
1141:       } else if (add.unit === 'g') {
1142:         const rawMgL = (add.amount * kmsMgPerGram) / volForStage;
1143:         const contributedMgL = Math.round(rawMgL * 10) / 10;
1144:         addedFromKmsMgL += rawMgL;
1145:         totalKmsMassGrams += add.amount;
1146:         stageBreakdown.push({
1147:           id: add.id,
1148:           stageTitle: add.stageTitle,
1149:           amountGrams: add.amount,
1150:           referenceVolumeL: volForStage,
1151:           contributedMgL,
1152:           formulaText: `${add.amount} g × ${kmsMgPerGram} ÷ ${volForStage} L = ${contributedMgL} mg/L`,
1153:           isDemo: add.isDemo
1154:         });
1155:       } else if (add.unit === 'kg') {
1156:         const grams = add.amount * 1000;
1157:         const rawMgL = (grams * kmsMgPerGram) / volForStage;
1158:         const contributedMgL = Math.round(rawMgL * 10) / 10;
1159:         addedFromKmsMgL += rawMgL;
1160:         totalKmsMassGrams += grams;
1161:         stageBreakdown.push({
1162:           id: add.id,
1163:           stageTitle: add.stageTitle,
1164:           amountGrams: Math.round(grams * 100) / 100,
1165:           referenceVolumeL: volForStage,
1166:           contributedMgL,
1167:           formulaText: `${add.amount} kg (${grams} g) × ${kmsMgPerGram} ÷ ${volForStage} L = ${contributedMgL} mg/L`,
1168:           isDemo: add.isDemo
1169:         });
1170:       } else if (add.unit === 'g/hL') {
1171:         const grams = (add.amount / 100) * volForStage;
1172:         const rawMgL = add.amount * kmsMgPerGhL;
1173:         const contributedMgL = Math.round(rawMgL * 10) / 10;
1174:         addedFromKmsMgL += rawMgL;
1175:         totalKmsMassGrams += grams;
1176:         stageBreakdown.push({
1177:           id: add.id,
1178:           stageTitle: add.stageTitle,
1179:           amountGrams: Math.round(grams * 100) / 100,
1180:           referenceVolumeL: volForStage,
1181:           contributedMgL,
1182:           formulaText: `${add.amount} g/hL × ${kmsMgPerGhL} = ${contributedMgL} mg/L`,
1183:           isDemo: add.isDemo
1184:         });
1185:       } else if (add.unit === 'mL') {
1186:         const grams = add.amount * 0.1;
1187:         const rawMgL = (add.amount * kmsMgPerMl10Pct) / volForStage;
1188:         const contributedMgL = Math.round(rawMgL * 10) / 10;
1189:         addedFromKmsMgL += rawMgL;
1190:         totalKmsMassGrams += grams;
1191:         stageBreakdown.push({
1192:           id: add.id,
1193:           stageTitle: add.stageTitle,
1194:           amountGrams: Math.round(grams * 100) / 100,
1195:           referenceVolumeL: volForStage,
1196:           contributedMgL,
1197:           formulaText: `${add.amount} mL (محلول ۱۰٪ = ${Math.round(grams * 100) / 100} g) × ${kmsMgPerGram} ÷ ${volForStage} L = ${contributedMgL} mg/L`,
1198:           isDemo: add.isDemo
1199:         });
1200:       } else {
1201:         skippedInvalidUnitCount += 1;
1202:       }
1203:     }
1204: 
1205:     const roundedAdded = Math.round(addedFromKmsMgL * 10) / 10;
1206:     const roundedTotalKmsMassGrams = Math.round(totalKmsMassGrams * 100) / 100;
1207:     const finalVolumeEquivalentMgL = Math.round(((totalKmsMassGrams * kmsMgPerGram) / effectiveVol) * 10) / 10;
1208:     const endogenousYeastMgL = MASTER_PROTOCOL_CONFIG.stoichiometry.yeastEndogenousSO2MgL;
1209:     const estimatedTotalSO2MgL = Math.round((roundedAdded + endogenousYeastMgL) * 10) / 10;
1210:     const legalCeilingMgL =
1211:       tankId === 'tank-rose'
1212:         ? residualSugarGL >= 5
1213:           ? 250
1214:           : 200
1215:         : residualSugarGL >= 5
1216:         ? 200
1217:         : 150;
1218:     const effectiveComparisonTotal = measuredTotalSO2MgL !== undefined ? measuredTotalSO2MgL : estimatedTotalSO2MgL;
1219:     const remainingBudgetMgL = Math.max(0, Math.round((legalCeilingMgL - effectiveComparisonTotal) * 10) / 10);
1220: 
1221:     return {
1222:       tankId,
1223:       batchId: targetBatchId,
1224:       addedFromKmsMgL: roundedAdded,
1225:       totalKmsMassGrams: roundedTotalKmsMassGrams,
1226:       finalVolumeEquivalentMgL,
1227:       skippedInvalidUnitCount,
1228:       endogenousYeastMgL,
1229:       estimatedTotalSO2MgL,
1230:       legalCeilingMgL,
1231:       remainingBudgetMgL,
1232:       isOverBudget: effectiveComparisonTotal > legalCeilingMgL,
1233:       accountingBasisFa:
1234:         'حسابداری اسمی سولفیت افزودهشده (Nominal Added SO2 Accounting — متفاوت از Total SO2 آزمایشگاهی)',
1235:       estimatedBoundAndVolatilizedRatio: 0.35,
1236:       measuredTotalSO2MgL,
1237:       stageBreakdown
1238:     };
1239:   }
