 678:   public startRealBatchMode(newBatch?: Omit<WineBatch, 'id'>): WineBatch | null {
 679:     this.hasLocalMutations = true;
 680:     this.batches = this.batches.filter((b) => b.isDemo !== true);
 681:     this.additions = this.additions.filter((a) => a.isDemo !== true);
 682:     this.analyses = this.analyses.filter((a) => a.isDemo !== true);
 683:     this.logs = this.logs.filter((l) => l.isBenchmark === true || l.isDemo !== true);
 684: 
 685:     let createdBatch: WineBatch | null = null;
 686:     if (newBatch) {
 687:       createdBatch = {
 688:         ...newBatch,
 689:         isDemo: false,
 690:         id: generateId('batch'),
 691:         updatedAtMs: newBatch.updatedAtMs ?? Date.now()
 692:       };
 693:       this.batches.unshift(createdBatch);
 694:     } else if (this.batches.length === 0) {
 695:       createdBatch = {
 696:         id: generateId('batch'),
 697:         name: 'بچ واقعی شماره ۱: انگور رشه سردشت',
 698:         grapeVariety: 'انگور سیاه رشه سردشت',
 699:         vintageYear: MASTER_PROTOCOL_CONFIG.metadata.vintageYear,
 700:         initialWeightKg: MASTER_PROTOCOL_CONFIG.metadata.grapeWeightKg,
 701:         targetStyle: 'red',
 702:         status: 'active_fermentation',
 703:         startDate: new Intl.DateTimeFormat('fa-IR').format(new Date()),
 704:         isDemo: false,
 705:         updatedAtMs: Date.now()
 706:       };
 707:       this.batches.unshift(createdBatch);
 708:     }
 709: 
 710:     this.persistBatches();
 711:     this.persistLogs();
 712:     this.persistAdditions();
 713:     this.persistAnalyses();
 714:     this.incrementChangesSinceBackup();
 715: 
 716:     return createdBatch ?? this.batches[0] ?? null;
 717:   }
