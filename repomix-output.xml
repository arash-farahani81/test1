 304: export function evaluateRightNowQueue(options: {
 305:   logs: FermentationLogEntry[];
 306:   additions: ChemicalAddition[];
 307:   activeTankId?: TankId;
 308:   completedRoadmapStepIds?: number[];
 309:   snoozedUntilMsByStepId?: Record<string, number>;
 310:   skippedReasonsByStepId?: Record<string, string>;
 311:   nowMs?: number;
 312:   plan?: DynamicProtocolPlan;
 313:   batch?: WineBatch;
 314:   batchId?: string;
 315:   excludeDemo?: boolean;
 316: }): RightNowQueueResult {
 317:   const plan = getEffectiveProtocolPlanForBatch(options.batch, options.plan);
 318:   const activeTankId: TankId = options.activeTankId ?? 'tank-a';
 319:   const completedStepIds = options.completedRoadmapStepIds ?? [];
 320:   const snoozedMap = options.snoozedUntilMsByStepId ?? {};
 321:   const skippedMap = options.skippedReasonsByStepId ?? {};
 322:   const nowMs = options.nowMs ?? Date.now();
 323: 
 324:   const activeBatchId = options.batchId ?? options.batch?.id ?? 'batch-rasha-1403';
 325:   const hasExplicitBatchFilter = Boolean(options.batchId || options.batch?.id);
 326:   const rejectOrphanRecords = Boolean(
 327:     hasExplicitBatchFilter && options.excludeDemo === true
 328:   );
 329:   const hasRealUserData = Boolean(
 330:     options.excludeDemo ||
 331:       options.batch?.isDemo === false ||
 332:       options.logs.some(
 333:         (l) =>
 334:           !l.isDeleted &&
 335:           !l.isBenchmark &&
 336:           !l.isDemo &&
 337:           (!l.batchId ? !rejectOrphanRecords : l.batchId === activeBatchId)
 338:       ) ||
 339:       options.additions.some(
 340:         (a) =>
 341:           !a.isDeleted &&
 342:           !a.isDemo &&
 343:           (!a.batchId ? !rejectOrphanRecords : a.batchId === activeBatchId)
 344:       )
 345:   );
 346: 
 347:   const isRecordMatchingActiveBatch = (recordBatchId?: string, recordTankId?: TankId): boolean => {
 348:     if (!hasExplicitBatchFilter) return true;
 349:     if (!recordBatchId) {
 350:       return !rejectOrphanRecords;
 351:     }
 352:     if (recordBatchId === activeBatchId) return true;
 353:     // In default factory demo mode only, allow companion demo rose batch records when viewing batch-rasha-1403
 354:     if (
 355:       !hasRealUserData &&
 356:       activeBatchId === 'batch-rasha-1403' &&
 357:       recordTankId === 'tank-rose' &&
 358:       recordBatchId === 'batch-rose-1403'
 359:     ) {
 360:       return true;
 361:     }
 362:     return false;
 363:   };
 364: 
 365:   const filteredLogs = options.logs.filter((l) => {
 366:     if (l.isDeleted) return false;
 367:     if (!isRecordMatchingActiveBatch(l.batchId, l.tankId)) {
 368:       return false;
 369:     }
 370:     if (hasRealUserData && (l.isDemo === true || l.isBenchmark === true)) {
 371:       return false;
 372:     }
 373:     return true;
 374:   });
 375: 
 376:   const activeLogsAll = filteredLogs.filter((l) => l.tankId === activeTankId);
 377:   const nonBenchmarkLogs = activeLogsAll.filter((l) => !l.isBenchmark);
 378:   const effectiveTankLogs = sortFermentationLogs(
 379:     nonBenchmarkLogs.length > 0 ? nonBenchmarkLogs : activeLogsAll
 380:   );
 381: 
 382:   const activeAdditions = options.additions.filter((a) => {
 383:     if (a.isDeleted) return false;
 384:     if (!isRecordMatchingActiveBatch(a.batchId, a.tankId)) {
 385:       return false;
 386:     }
 387:     if (hasRealUserData && a.isDemo === true) {
 388:       return false;
 389:     }
 390:     return true;
 391:   });
 392: 
 393:   // Check SG anomaly on active tank
 394:   let sgAnomaly: SgAnomalyAlert | null = null;
 395:   if (effectiveTankLogs.length >= 2) {
 396:     const prevLog = effectiveTankLogs[effectiveTankLogs.length - 2];
 397:     const latestLog = effectiveTankLogs[effectiveTankLogs.length - 1];
 398:     if (latestLog.sg > prevLog.sg + 0.002) {
 399:       sgAnomaly = {
 400:         hasAnomaly: true,
 401:         previousSG: prevLog.sg,
 402:         currentSG: latestLog.sg,
 403:         titleFa: 'تخمیر متوقف یا اشتباه ثبت؟',
